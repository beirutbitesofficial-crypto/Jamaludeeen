<%- include('partials/header', { title: title }) %>
<% const ar = lang === 'ar';
   const base = `/collections/${brand.id}/category/${category.id}`;
   const pageLink = n => `${base}?${new URLSearchParams(Object.assign({}, filters.q ? { q: filters.q } : {}, { page: n })).toString()}`; %>

<main>
  <section class="page-hero">
    <div class="container">
      <nav class="crumbs"><a href="/"><%= t.home %></a><span>/</span><a href="/collections"><%= t.brands %></a><span>/</span><a href="/collections/<%= brand.id %>"><bdi><%= brand.name %></bdi></a><span>/</span><span><%= category.name_en %></span></nav>
      <div class="page-hero__row">
        <div>
          <p class="eyebrow"><span></span><bdi><%= brand.name %></bdi></p>
          <h1 class="display display--xl"><%= ar && category.name_ar ? category.name_ar : category.name_en %></h1>
          <% if (!ar && category.name_ar) { %><p class="page-hero__lede" lang="ar"><%= category.name_ar %></p><% } %>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <div class="toolbar">
        <form method="GET" action="<%= base %>" class="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" name="q" value="<%= filters.q || '' %>" placeholder="<%= t.search_placeholder %>" aria-label="Search"/>
          <button type="submit"><%= ar ? 'بحث' : 'Search' %></button>
        </form>
        <p class="toolbar__count"><%= pagination.total %> <%= t.products %><% if (filters.q) { %> · <a href="<%= base %>"><%= ar ? 'مسح' : 'Clear' %></a><% } %></p>
      </div>

      <% if (!products.length) { %>
        <div class="empty">
          <span class="empty__mark">✦</span>
          <h2><%= t.no_products %></h2>
          <a href="<%= base %>" class="btn btn--dark"><%= ar ? 'مسح البحث' : 'Clear search' %></a>
        </div>
      <% } else { %>
        <div class="grid-products grid-products--catalog">
          <% products.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %>
        </div>
        <% if (pagination.totalPages > 1) { %>
        <nav class="pager" aria-label="Pagination">
          <% if (pagination.page > 1) { %><a href="<%= pageLink(pagination.page - 1) %>" class="pager__step">← <%= t.prev %></a><% } else { %><span class="pager__step is-disabled">← <%= t.prev %></span><% } %>
          <span class="pager__info"><em><%= pagination.page %></em> / <%= pagination.totalPages %></span>
          <% if (pagination.page < pagination.totalPages) { %><a href="<%= pageLink(pagination.page + 1) %>" class="pager__step"><%= t.next_page %> →</a><% } else { %><span class="pager__step is-disabled"><%= t.next_page %> →</span><% } %>
        </nav>
        <% } %>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
