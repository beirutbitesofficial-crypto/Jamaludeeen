<%- include('../partials/admin-header', { title: a('orders') }) %>
<%
  const qs = o => new URLSearchParams(Object.fromEntries(Object.entries(Object.assign({}, filters, o)).filter(([, v]) => v !== '' && v != null))).toString();
  const all = Object.values(statusCounts).reduce((s, n) => s + n, 0);
  const fmtDate = d => d ? new Date(String(d).replace(' ', 'T') + (String(d).includes('Z') ? '' : 'Z')).toLocaleString(a.lang === 'ar' ? 'ar-LB' : 'en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
%>
<div class="bo-head">
  <div>
    <p class="bo-kicker"><%= a('website_revenue') %></p>
    <h1><%= a('orders') %></h1>
  </div>
</div>

<nav class="tabs">
  <a href="/admin/orders" class="<%= !filters.status ? 'is-active' : '' %>"><%= a('st_all') %><span class="tabs__count num"><%= all %></span></a>
  <% ['pending','confirmed','shipped','delivered','cancelled'].forEach(s => { %>
  <a href="?<%= qs({ status: s, page: '' }) %>" class="<%= filters.status === s ? 'is-active' : '' %>"><%= a('st_' + s) %><span class="tabs__count num"><%= statusCounts[s] || 0 %></span></a>
  <% }) %>
</nav>

<form class="toolbar" method="GET" action="/admin/orders">
  <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"/><% } %>
  <label class="search toolbar__grow"><%- icon('search') %><input type="search" name="q" value="<%= filters.q %>" placeholder="# / <%= a('customer') %> / <%= a('phone') %>"/></label>
  <button class="btn" type="submit"><%= a('search') %></button>
  <% if (filters.q) { %><a class="btn btn--ghost" href="?<%= qs({ q: '', page: '' }) %>"><%= a('clear') %></a><% } %>
</form>

<section class="card">
  <div class="table-wrap">
    <table class="table table-cards">
      <thead><tr><th>#</th><th><%= a('customer') %></th><th><%= a('city') %></th><th><%= a('payment') %></th><th><%= a('total') %></th><th><%= a('status') %></th><th><%= a('date') %></th><th></th></tr></thead>
      <tbody>
        <% if (!orders.length) { %><tr><td colspan="8" class="empty"><%= a('no_orders') %></td></tr><% } %>
        <% orders.forEach(o => { %>
        <tr>
          <td><a href="/admin/orders/<%= o.id %>"><strong class="num" dir="ltr"><%= o.order_number %></strong></a></td>
          <td><strong><%= o.customer_name %></strong><br/><small class="muted num" dir="ltr"><%= o.customer_phone %></small></td>
          <td><%= o.customer_city %></td>
          <td><span class="pill pill--plain"><%= a(o.payment_method) %></span></td>
          <td class="num" dir="ltr"><strong><%= money(o.total, o.currency || 'LBP') %></strong></td>
          <td><span class="pill st-<%= o.status %>"><%= a('st_' + o.status) %></span></td>
          <td class="muted"><%= fmtDate(o.created_at) %></td>
          <td class="actions"><a class="btn btn--sm" href="/admin/orders/<%= o.id %>"><%= a('view') %></a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (pagination.totalPages > 1) { %>
  <div class="pager">
    <span class="num"><%= a('page') %> <%= pagination.page %> <%= a('of') %> <%= pagination.totalPages %> · <%= pagination.total %></span>
    <span class="pager__links">
      <% if (pagination.page > 1) { %><a class="btn btn--sm" href="?<%= qs({ page: pagination.page - 1 }) %>"><%= a('prev') %></a><% } %>
      <% if (pagination.page < pagination.totalPages) { %><a class="btn btn--sm" href="?<%= qs({ page: pagination.page + 1 }) %>"><%= a('next') %></a><% } %>
    </span>
  </div>
  <% } %>
</section>
<%- include('../partials/admin-footer') %>
