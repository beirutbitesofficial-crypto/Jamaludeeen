<%- include('../partials/admin-header', { title: 'Orders' }) %>

<div class="admin-page">
  <div class="admin-page__header">
    <h1 class="admin-page__title">Orders <span class="count-badge"><%= pagination.total %></span></h1>
  </div>

  <!-- Status filter tabs -->
  <div class="status-tabs">
    <% ['all','pending','confirmed','shipped','delivered','cancelled'].forEach(s => { %>
    <a href="/admin/orders<%= s !== 'all' ? '?status='+s : '' %>"
       class="status-tab status-tab--<%= s %> <%= (filters.status || 'all') === s ? 'active' : '' %>">
      <%= s.charAt(0).toUpperCase() + s.slice(1) %>
    </a>
    <% }) %>
  </div>

  <div class="table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Order #</th>
          <th>Customer</th>
          <th>Phone</th>
          <th>City</th>
          <th>Total</th>
          <th>Payment</th>
          <th>Status</th>
          <th>Date</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!orders.length) { %>
        <tr><td colspan="9" class="empty-row">No orders found</td></tr>
        <% } %>
        <% orders.forEach(o => { %>
        <tr>
          <td><strong><%= o.order_number %></strong></td>
          <td><%= o.customer_name %></td>
          <td><a href="tel:<%= o.customer_phone %>"><%= o.customer_phone %></a></td>
          <td><%= o.customer_city %></td>
          <td><strong><%= o.total.toLocaleString() %> LBP</strong></td>
          <td><span class="badge-pay badge-pay--<%= o.payment_method %>"><%= o.payment_method === 'cod' ? '💵 COD' : '📱 Whish' %></span></td>
          <td><span class="badge-status badge-status--<%= o.status %>"><%= o.status %></span></td>
          <td class="muted"><%= new Date(o.created_at).toLocaleString() %></td>
          <td><a href="/admin/orders/<%= o.id %>" class="btn-sm">View</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (pagination.totalPages > 1) { %>
  <div class="pagination">
    <% if (pagination.page > 1) { %>
    <a href="/admin/orders?<%= new URLSearchParams({...filters, page: pagination.page - 1}).toString() %>" class="pagination__btn">← Prev</a>
    <% } %>
    <span class="pagination__info">Page <%= pagination.page %> / <%= pagination.totalPages %></span>
    <% if (pagination.page < pagination.totalPages) { %>
    <a href="/admin/orders?<%= new URLSearchParams({...filters, page: pagination.page + 1}).toString() %>" class="pagination__btn">Next →</a>
    <% } %>
  </div>
  <% } %>

</div>

<%- include('../partials/admin-footer') %>
