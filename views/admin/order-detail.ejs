<%- include('../partials/admin-header', { title: a('order') + ' ' + order.order_number }) %>
<%
  const cur = order.currency || 'LBP';
  const wa = String(order.customer_phone || '').replace(/[^\d]/g, '').replace(/^0/, '961');
  const fmtDate = d => d ? new Date(String(d).replace(' ', 'T') + (String(d).includes('Z') ? '' : 'Z')).toLocaleString(a.lang === 'ar' ? 'ar-LB' : 'en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : '';
%>
<a class="bo-back" href="/admin/orders"><%- icon('back') %><%= a('back_to_orders') %></a>
<div class="bo-head">
  <div>
    <p class="bo-kicker"><%= fmtDate(order.created_at) %></p>
    <h1 dir="ltr" style="text-align:start"><%= order.order_number %></h1>
    <p><span class="pill st-<%= order.status %>"><%= a('st_' + order.status) %></span> <span class="pill pill--plain"><%= a(order.payment_method) %></span></p>
  </div>
  <div class="bo-head__actions">
    <a class="btn" href="https://wa.me/<%= wa %>" target="_blank" rel="noopener"><%- icon('whatsapp') %><%= a('whatsapp_customer') %></a>
    <button class="btn" onclick="window.print()"><%- icon('print') %></button>
  </div>
</div>

<div class="grid grid--side">
  <section class="card">
    <div class="card__head"><h2><%= a('items_ordered') %></h2></div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th><%= a('product') %></th><th><%= a('size') %></th><th><%= a('quantity') %></th><th><%= a('price') %></th><th><%= a('line_total') %></th></tr></thead>
        <tbody>
          <% items.forEach(i => { %>
          <tr>
            <td><span class="prod-cell"><% if (i.image_path) { %><img class="thumb" src="<%= i.image_path %>" alt=""/><% } else { %><span class="thumb thumb--empty">J</span><% } %><span><strong><%= i.product_name %></strong></span></span></td>
            <td class="num"><%= i.size_ml ? i.size_ml + ' ml' : '—' %></td>
            <td class="num">× <%= i.quantity %></td>
            <td class="num" dir="ltr"><%= money(i.price, cur) %></td>
            <td class="num" dir="ltr"><strong><%= money(i.price * i.quantity, cur) %></strong></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="card__body">
      <dl class="kv" style="max-width:360px;margin-inline-start:auto">
        <dt><%= a('subtotal') %></dt><dd class="num" dir="ltr"><%= money(order.subtotal, cur) %></dd>
        <dt><%= a('delivery') %></dt><dd class="num" dir="ltr"><%= order.delivery_fee ? money(order.delivery_fee, cur) : a('free') %></dd>
        <dt><strong><%= a('total') %></strong></dt><dd class="num" dir="ltr"><strong style="font-size:1.15rem"><%= money(order.total, cur) %></strong></dd>
      </dl>
    </div>
  </section>

  <div style="display:grid;gap:20px;align-content:start">
    <form class="card" action="/admin/orders/<%= order.id %>/status" method="POST">
      <div class="card__head"><h2><%= a('order_status') %></h2></div>
      <div class="card__body form">
        <select name="status">
          <% ['pending','confirmed','shipped','delivered','cancelled'].forEach(s => { %><option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= a('st_' + s) %></option><% }) %>
        </select>
        <button class="btn btn--dark btn--block" type="submit"><%- icon('check') %><%= a('update_status') %></button>
      </div>
    </form>
    <section class="card">
      <div class="card__head"><h2><%= a('customer') %></h2></div>
      <div class="card__body">
        <dl class="kv" style="grid-template-columns:90px 1fr">
          <dt><%= a('name') %></dt><dd><strong><%= order.customer_name %></strong></dd>
          <dt><%= a('phone') %></dt><dd dir="ltr" style="text-align:start"><a href="tel:<%= order.customer_phone %>"><%= order.customer_phone %></a></dd>
          <dt><%= a('city') %></dt><dd><%= order.customer_city %></dd>
          <dt><%= a('address') %></dt><dd><%= order.customer_address %></dd>
          <% if (order.notes) { %><dt><%= a('notes') %></dt><dd><%= order.notes %></dd><% } %>
        </dl>
      </div>
    </section>
  </div>
</div>
<%- include('../partials/admin-footer') %>
