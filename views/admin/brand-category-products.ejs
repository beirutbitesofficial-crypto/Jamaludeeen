<%- include('../partials/admin-header', { title: brand.name + ' · ' + category.name_en }) %>
<a class="bo-back" href="/admin/brands/<%= brand.id %>/categories"><%- icon('back') %><%= brand.name %></a>
<div class="bo-head">
  <div><p class="bo-kicker"><%= brand.name %></p><h1><%= category.name_en %></h1></div>
  <div class="bo-head__actions"><button class="btn btn--dark" data-open="newLineProduct"><%- icon('plus') %><%= a('add_product') %></button></div>
</div>

<div class="grid grid--2" style="align-items:start">
  <section class="card">
    <div class="card__head"><h2><%= a('in_this_line') %> <span class="pill pill--plain num"><%= assigned.length %></span></h2></div>
    <% if (!assigned.length) { %><div class="empty-block"><p><%= a('none') %></p></div><% } %>
    <% assigned.forEach(p => { %>
    <div class="list-row">
      <a class="prod-cell" href="/admin/products/<%= p.id %>/edit">
        <% if (p.image_path) { %><img class="thumb" src="<%= p.image_path %>" alt="" loading="lazy"/><% } else { %><span class="thumb thumb--empty">J</span><% } %>
        <span><strong><%= p.name_en %></strong><small dir="ltr"><%= p.price ? money(p.price, 'LBP') : a('not_set') %></small></span>
      </a>
      <form action="/admin/brands/<%= brand.id %>/categories/<%= category.id %>/products/remove" method="POST">
        <input type="hidden" name="product_id" value="<%= p.id %>"/>
        <button class="btn btn--sm btn--ghost" type="submit" title="<%= a('remove') %>"><%- icon('x') %></button>
      </form>
    </div>
    <% }) %>
  </section>

  <form class="card" action="/admin/brands/<%= brand.id %>/categories/<%= category.id %>/products/add" method="POST">
    <div class="card__head"><h2><%= a('not_in_line') %> <span class="pill pill--plain num"><%= unassigned.length %></span></h2>
      <% if (unassigned.length) { %><button class="btn btn--sm btn--dark" type="submit"><%- icon('plus') %><%= a('add_selected') %></button><% } %></div>
    <% if (!unassigned.length) { %><div class="empty-block"><p><%= a('none') %></p></div><% } %>
    <% unassigned.forEach(p => { %>
    <label class="list-row" style="cursor:pointer">
      <span class="prod-cell">
        <% if (p.image_path) { %><img class="thumb" src="<%= p.image_path %>" alt="" loading="lazy"/><% } else { %><span class="thumb thumb--empty">J</span><% } %>
        <span><strong><%= p.name_en %></strong></span>
      </span>
      <input type="checkbox" name="product_ids" value="<%= p.id %>" style="width:20px;height:20px;accent-color:#b08d57"/>
    </label>
    <% }) %>
  </form>
</div>

<div class="modal" id="newLineProduct">
  <div class="modal__box">
    <div class="modal__head"><h3><%= a('new_product') %> · <%= category.name_en %></h3><button class="modal__close" data-close><%- icon('x') %></button></div>
    <form class="modal__body form" action="/admin/brands/<%= brand.id %>/categories/<%= category.id %>/products/new" method="POST" enctype="multipart/form-data">
      <label class="field"><span><%= a('name_en') %></span><input name="name_en" required/></label>
      <label class="field"><span><%= a('name_ar') %> <small>(<%= a('optional') %>)</small></span><input name="name_ar" dir="rtl"/></label>
      <label class="field"><span><%= a('price_lbp') %></span><span class="input-affix"><input type="number" name="price" min="0" step="1000" dir="ltr"/><span>LBP</span></span></label>
      <label class="field"><span><%= a('image') %> <small>(<%= a('optional') %>)</small></span><input type="file" name="image" accept="image/jpeg,image/png,image/webp"/></label>
      <button class="btn btn--dark btn--block" type="submit"><%- icon('plus') %><%= a('create') %></button>
    </form>
  </div>
</div>
<%- include('../partials/admin-footer') %>
