<%- include('../partials/admin-header', { title: a('edit_product') }) %>
<% const isBrand = product.type === 'brand'; const section = isBrand ? 'brands' : product.category; %>
<a class="bo-back" href="/admin/products?section=<%= section %><%= isBrand ? '&brand=' + encodeURIComponent(product.brand) : '' %>"><%- icon('back') %><%= a('products') %> · <%= a(section) %></a>
<div class="bo-head">
  <div>
    <p class="bo-kicker"><%= isBrand ? a('brand_product') + ' · ' + product.brand : a('signature_refill') + ' · ' + a(section) %></p>
    <h1><%= product.name_en %></h1>
  </div>
  <div class="bo-head__actions"><a href="/shop/item/<%= product.id %>" target="_blank" class="btn"><%- icon('external') %><%= a('view_on_store') %></a></div>
</div>

<div class="grid grid--side" style="grid-template-columns:340px minmax(0,1fr)">
  <section class="card">
    <div class="card__head"><h2><%= a('product_photo') %></h2></div>
    <div class="card__body" style="display:grid;gap:12px">
      <div class="photo-box"><% if (product.image_path) { %><img src="<%= product.image_path %>" alt="<%= product.name_en %>"/><% } else { %><span class="monogram">J</span><% } %></div>
      <form action="/admin/products/<%= product.id %>/image" method="POST" enctype="multipart/form-data">
        <label class="btn btn--dark btn--block upload"><%- icon('upload') %><%= product.image_path ? a('change') : a('upload') %><input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-autosubmit/></label>
      </form>
      <small class="hint"><%= a('image_hint') %></small>
      <% if (product.image_path) { %>
      <form action="/admin/products/<%= product.id %>/delete-image" method="POST" data-confirm="<%= a('confirm_delete') %>">
        <button class="btn btn--sm btn--ghost btn--danger btn--block" type="submit"><%- icon('trash') %><%= a('remove_photo') %></button>
      </form>
      <% } %>
    </div>
  </section>

  <form class="card" action="/admin/products/<%= product.id %>" method="POST">
    <div class="card__head"><h2><%= a('edit_product') %></h2><button class="btn btn--dark" type="submit"><%- icon('check') %><%= a('save_changes') %></button></div>
    <div class="card__body form">
      <div class="field--row">
        <label class="field"><span><%= a('name_en') %></span><input name="name_en" value="<%= product.name_en %>" required/></label>
        <label class="field"><span><%= a('name_ar') %></span><input name="name_ar" value="<%= product.name_ar || '' %>" dir="rtl"/></label>
      </div>
      <% if (isBrand) { %>
      <label class="field"><span><%= a('price_lbp') %></span>
        <span class="input-affix"><input type="number" name="price" min="0" step="1000" value="<%= product.price != null ? product.price : '' %>" dir="ltr"/><span>LBP</span></span>
        <small><%= a('price_empty_hint') %><% if (product.price) { %> · ≈ <span dir="ltr"><%= money(product.price / usdRate, 'USD') %></span><% } %></small>
      </label>
      <% } else { %>
      <div class="field--row">
        <label class="field"><span><%= a('section') %></span>
          <select name="section"><% ['men','women','unisex'].forEach(k => { %><option value="<%= k %>" <%= product.category === k ? 'selected' : '' %>><%= a(k) %></option><% }) %></select>
        </label>
        <label class="field"><span><%= a('original_house') %></span><input name="house" value="<%= product.brand || '' %>"/></label>
      </div>
      <div class="note"><%- icon('coin') %><span><%= a('refill_price_managed') %> <b dir="ltr">50 ml $<%= refill[50] %> · 100 ml $<%= refill[100] %></b> — <a href="/admin/prices" style="text-decoration:underline"><%= a('edit_refill_prices') %></a></span></div>
      <% } %>
      <div class="field--row">
        <label class="field"><span><%= a('description_en') %></span><textarea name="description_en"><%= product.description_en || '' %></textarea></label>
        <label class="field"><span><%= a('description_ar') %></span><textarea name="description_ar" dir="rtl"><%= product.description_ar || '' %></textarea></label>
      </div>
      <div class="field--row">
        <label class="switch"><span><strong><%= a('available') %></strong><small><%= a('in_stock') %> / <%= a('out_of_stock') %></small></span><input type="hidden" name="in_stock" value="0"/><input type="checkbox" name="in_stock" value="1" <%= product.in_stock ? 'checked' : '' %>/><span class="switch__ui"></span></label>
        <label class="switch"><span><strong><%= a('featured') %></strong><small><%= a('featured_home') %></small></span><input type="hidden" name="featured" value="0"/><input type="checkbox" name="featured" value="1" <%= product.featured ? 'checked' : '' %>/><span class="switch__ui"></span></label>
      </div>
    </div>
  </form>
</div>
<%- include('../partials/admin-footer') %>
