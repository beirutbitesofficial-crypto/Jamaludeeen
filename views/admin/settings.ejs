<%- include('../partials/admin-header', { title: a('settings') }) %>
<div class="bo-head">
  <div><p class="bo-kicker"><%= a('admin_panel') %></p><h1><%= a('settings') %></h1></div>
</div>

<div class="grid grid--side">
  <form class="card" action="/admin/settings" method="POST">
    <div class="card__head"><h2><%- icon('store') %> <%= a('store_details') %></h2><button class="btn btn--dark" type="submit"><%- icon('check') %><%= a('save_changes') %></button></div>
    <div class="card__body form">
      <label class="field"><span><%= a('exchange_rate') %></span>
        <span class="input-affix"><span>1 USD =</span><input type="number" name="exchange_rate" min="1" step="100" value="<%= rate %>" required dir="ltr"/><span>LBP</span></span>
        <small><%= a('exchange_hint') %></small></label>
      <div class="field--row">
        <label class="field"><span><%= a('store_phone') %></span><input name="store_phone" value="<%= settings.store_phone || '' %>" dir="ltr"/></label>
        <label class="field"><span><%= a('store_whatsapp') %></span><input name="store_whatsapp" value="<%= settings.store_whatsapp || '' %>" dir="ltr" placeholder="9613xxxxxx"/><small><%= a('store_whatsapp_hint') %></small></label>
      </div>
      <div class="field--row">
        <label class="field"><span><%= a('whish_number') %></span><input name="whish_number" value="<%= settings.whish_number || '' %>" dir="ltr"/><small><%= a('whish_hint') %></small></label>
        <label class="field"><span><%= a('delivery_fee') %></span><span class="input-affix"><input type="number" name="delivery_fee" min="0" step="1000" value="<%= settings.delivery_fee || 0 %>" dir="ltr"/><span>LBP</span></span></label>
      </div>
      <label class="field"><span><%= a('store_address') %></span><input name="store_address" value="<%= settings.store_address || '' %>"/></label>
      <div class="field--row">
        <label class="field"><span><%= a('instagram') %></span><input name="instagram" value="<%= settings.instagram || '' %>" dir="ltr" placeholder="https://instagram.com/…"/></label>
        <label class="field"><span><%= a('tiktok') %></span><input name="tiktok" value="<%= settings.tiktok || '' %>" dir="ltr" placeholder="https://tiktok.com/@…"/></label>
      </div>
    </div>
  </form>

  <form class="card" action="/admin/change-password" method="POST" style="align-self:start">
    <div class="card__head"><h2><%= a('change_password') %></h2></div>
    <div class="card__body form">
      <label class="field"><span><%= a('current_password') %></span><input type="password" name="current" required autocomplete="current-password"/></label>
      <label class="field"><span><%= a('new_password') %></span><input type="password" name="newPass" required minlength="8" autocomplete="new-password"/><small><%= a('pw_short') %></small></label>
      <label class="field"><span><%= a('confirm_password') %></span><input type="password" name="confirm" required minlength="8" autocomplete="new-password"/></label>
      <button class="btn btn--dark btn--block" type="submit"><%= a('change_password') %></button>
    </div>
  </form>
</div>
<%- include('../partials/admin-footer') %>
