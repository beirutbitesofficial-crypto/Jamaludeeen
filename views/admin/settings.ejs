<%- include('../partials/admin-header', { title: 'Settings' }) %>

<div class="admin-page">
  <h1 class="admin-page__title">⚙️ Settings</h1>

  <div class="settings-layout">

    <!-- Store Settings -->
    <div class="settings-card">
      <h3 class="panel-title">Store Settings</h3>
      <form action="/admin/settings" method="POST">
        <div class="form-group">
          <label class="form-label">ByWhish Money Number</label>
          <input type="text" name="whish_number" class="form-input"
                 value="<%= settings.whish_number || '' %>" placeholder="+961 70 000 000"/>
          <p class="form-hint">Customers will send payment to this number</p>
        </div>
        <div class="form-group">
          <label class="form-label">Store Phone</label>
          <input type="text" name="store_phone" class="form-input"
                 value="<%= settings.store_phone || '' %>" placeholder="+961 70 000 000"/>
        </div>
        <div class="form-group">
          <label class="form-label">WhatsApp Number</label>
          <input type="text" name="store_whatsapp" class="form-input"
                 value="<%= settings.store_whatsapp || '' %>" placeholder="+96170000000"/>
          <p class="form-hint">Include country code, no spaces (e.g. 96170123456)</p>
        </div>
        <div class="form-group">
          <label class="form-label">Store Address / Location</label>
          <input type="text" name="store_address" class="form-input"
                 value="<%= settings.store_address || '' %>" placeholder="Lebanon"/>
        </div>
        <div class="form-group">
          <label class="form-label">Delivery Fee (LBP) — 0 for free</label>
          <input type="number" name="delivery_fee" class="form-input"
                 value="<%= settings.delivery_fee || 0 %>" min="0" step="1000"/>
        </div>
        <div class="form-group">
          <label class="form-label">USD Exchange Rate (LBP per $1)</label>
          <input type="number" name="usd_rate" class="form-input"
                 value="<%= settings.usd_rate || 89500 %>" min="1" step="500"/>
          <p class="form-hint">Used for LBP ⇔ USD toggle on the store. Current: 1 USD = <%= settings.usd_rate || 89500 %> LBP</p>
        </div>
        <button type="submit" class="btn btn--primary">💾 Save Settings</button>
      </form>
    </div>

    <!-- Hero Banner -->
    <div class="settings-card">
      <h3 class="panel-title">Home Page Banner Text</h3>
      <form action="/admin/settings" method="POST">
        <div class="form-group">
          <label class="form-label">Hero Title (English)</label>
          <input type="text" name="hero_title_en" class="form-input"
                 value="<%= settings.hero_title_en || '' %>"/>
        </div>
        <div class="form-group">
          <label class="form-label">Hero Title (Arabic)</label>
          <input type="text" name="hero_title_ar" class="form-input" dir="rtl"
                 value="<%= settings.hero_title_ar || '' %>"/>
        </div>
        <div class="form-group">
          <label class="form-label">Hero Subtitle (English)</label>
          <input type="text" name="hero_sub_en" class="form-input"
                 value="<%= settings.hero_sub_en || '' %>"/>
        </div>
        <div class="form-group">
          <label class="form-label">Hero Subtitle (Arabic)</label>
          <input type="text" name="hero_sub_ar" class="form-input" dir="rtl"
                 value="<%= settings.hero_sub_ar || '' %>"/>
        </div>
        <button type="submit" class="btn btn--primary">💾 Save Banner</button>
      </form>
    </div>

    <!-- Change Password -->
    <div class="settings-card">
      <h3 class="panel-title">Change Admin Password</h3>
      <form action="/admin/change-password" method="POST">
        <div class="form-group">
          <label class="form-label">Current Password</label>
          <input type="password" name="current" class="form-input" required/>
        </div>
        <div class="form-group">
          <label class="form-label">New Password</label>
          <input type="password" name="newPass" class="form-input" required minlength="6"/>
        </div>
        <div class="form-group">
          <label class="form-label">Confirm New Password</label>
          <input type="password" name="confirm" class="form-input" required minlength="6"/>
        </div>
        <button type="submit" class="btn btn--outline">🔒 Change Password</button>
      </form>
    </div>

    <!-- Banner Image -->
    <div class="settings-card">
      <h3 class="panel-title">🖼️ Hero Banner Image</h3>
      <p class="form-hint" style="margin-bottom:16px">This image appears as the homepage hero background.</p>

      <% if (settings.banner_image) { %>
        <div class="img-preview-wrap">
          <img src="<%= settings.banner_image %>" class="settings-img-preview" alt="Banner"/>
          <form action="/admin/settings/delete-image/banner" method="POST" style="margin-top:8px">
            <button type="submit" class="btn btn--outline btn--sm btn--danger"
                    onclick="return confirm('Remove banner image?')">✕ Remove</button>
          </form>
        </div>
      <% } else { %>
        <div class="img-placeholder-box">No banner image set</div>
      <% } %>

      <form action="/admin/settings/upload-image/banner" method="POST" enctype="multipart/form-data" class="upload-form-inline">
        <label class="upload-btn-big">
          📷 <%= settings.banner_image ? 'Change Banner' : 'Upload Banner' %>
          <input type="file" name="image" accept="image/jpeg,image/png,image/webp"
                 onchange="this.form.submit()"/>
        </label>
        <p class="form-hint">JPG/PNG/WebP — max 10 MB. Recommended: 1920×1080</p>
      </form>
    </div>

    <!-- Category Images -->
    <div class="settings-card">
      <h3 class="panel-title">🗂️ Category Images</h3>
      <p class="form-hint" style="margin-bottom:20px">One background image per category card on homepage.</p>

      <div class="cat-img-grid">
        <% [['men','♟ Men'],['women','✦ Women'],['unisex','◈ Unisex']].forEach(([cat,label]) => { %>
        <div class="cat-img-card">
          <div class="cat-img-card__label"><%= label %></div>
          <% const key = cat + '_image'; const img = settings[key]; %>
          <% if (img) { %>
            <img src="<%= img %>" class="cat-img-card__img" alt="<%= cat %>"/>
            <form action="/admin/settings/delete-image/<%= cat %>" method="POST">
              <button type="submit" class="btn btn--sm btn--danger"
                      onclick="return confirm('Remove?')">✕</button>
            </form>
          <% } else { %>
            <div class="cat-img-placeholder">No image</div>
          <% } %>
          <form action="/admin/settings/upload-image/<%= cat %>" method="POST" enctype="multipart/form-data">
            <label class="upload-btn-big upload-btn-big--sm">
              📷 <%= img ? 'Change' : 'Upload' %>
              <input type="file" name="image" accept="image/jpeg,image/png,image/webp"
                     onchange="this.form.submit()"/>
            </label>
          </form>
        </div>
        <% }) %>
      </div>
    </div>

  </div>
</div>

<%- include('../partials/admin-footer') %>
