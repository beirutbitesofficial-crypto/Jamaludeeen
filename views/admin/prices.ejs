<%- include('../partials/admin-header', { title: a('prices') }) %>
<% const qs = new URLSearchParams(Object.fromEntries(Object.entries(filters).filter(([, v]) => v))).toString(); %>
<div class="bo-head">
  <div>
    <p class="bo-kicker"><%= a('catalog') %></p>
    <h1><%= a('prices') %></h1>
    <p><%= a('prices_intro') %></p>
  </div>
</div>

<div class="grid grid--2" style="align-items:start">
  <form class="card" action="/admin/prices/refill" method="POST">
    <div class="card__head"><h2><%- icon('bottle') %> <%= a('refill_prices') %></h2><span class="pill pill--gold pill--plain"><%= a('men') %> · <%= a('women') %> · <%= a('unisex') %></span></div>
    <div class="card__body form">
      <div class="field--row">
        <label class="field"><span><%= a('price_50') %></span><span class="input-affix"><input type="number" name="price_50" min="0.5" step="0.5" value="<%= refill[50] %>" required dir="ltr"/><span>USD</span></span>
          <small><%= a('pos_equivalent') %>: <span dir="ltr" class="num"><%= money(refill[50] * rate, 'LBP') %></span></small></label>
        <label class="field"><span><%= a('price_100') %></span><span class="input-affix"><input type="number" name="price_100" min="0.5" step="0.5" value="<%= refill[100] %>" required dir="ltr"/><span>USD</span></span>
          <small><%= a('pos_equivalent') %>: <span dir="ltr" class="num"><%= money(refill[100] * rate, 'LBP') %></span></small></label>
      </div>
      <div class="form__actions"><button class="btn btn--dark" type="submit"><%- icon('check') %><%= a('save') %></button></div>
    </div>
  </form>

  <section class="card">
    <div class="card__head"><h2><%- icon('coin') %> <%= a('exchange_rate') %></h2><a class="btn btn--sm" href="/admin/settings"><%= a('edit') %></a></div>
    <div class="card__body">
      <p class="stat__value num" dir="ltr" style="margin:0">1 USD = <%= Number(rate).toLocaleString('en-US') %> LBP</p>
      <p class="hint"><%= a('exchange_hint') %></p>
    </div>
  </section>
</div>

<div class="bo-head" style="margin-top:28px">
  <div><h2 style="margin:0"><%= a('brand_prices') %></h2><p><%= a('brand_note') %></p></div>
</div>

<div class="chips chips--scroll">
  <a class="chip <%= !filters.brand ? 'is-active' : '' %>" href="/admin/prices<%= filters.q ? '?q=' + encodeURIComponent(filters.q) : '' %>"><%= a('all_brands') %></a>
  <% brands.forEach(b => { %><a class="chip <%= filters.brand === b.name ? 'is-active' : '' %>" href="?brand=<%= encodeURIComponent(b.name) %>"><%= b.name %> <small class="num"><%= b.count %></small></a><% }) %>
</div>

<form class="toolbar" method="GET" action="/admin/prices">
  <% if (filters.brand) { %><input type="hidden" name="brand" value="<%= filters.brand %>"/><% } %>
  <label class="search toolbar__grow"><%- icon('search') %><input type="search" name="q" value="<%= filters.q %>" placeholder="<%= a('search_products') %>"/></label>
  <button class="btn" type="submit"><%= a('search') %></button>
</form>

<form class="card" action="/admin/prices/bulk" method="POST" id="bulkPrices">
  <input type="hidden" name="_qs" value="<%= qs %>"/>
  <div class="card__head">
    <div class="toolbar" style="margin:0;padding:0;border:0;background:none">
      <span class="muted"><%= a('set_all') %></span>
      <span class="input-affix" style="max-width:190px"><input type="number" id="setAllValue" min="0" step="1000" dir="ltr"/><span>LBP</span></span>
      <button type="button" class="btn btn--sm" id="setAllBtn"><%= a('apply') %></button>
    </div>
    <button class="btn btn--dark" type="submit"><%- icon('check') %><%= a('save_all_prices') %></button>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th><%= a('product') %></th><th><%= a('brand') %></th><th style="width:220px"><%= a('price_lbp') %></th></tr></thead>
      <tbody>
        <% if (!products.length) { %><tr><td colspan="3" class="empty"><%= a('no_results') %></td></tr><% } %>
        <% products.forEach(p => { %>
        <tr>
          <td><a class="prod-cell" href="/admin/products/<%= p.id %>/edit"><% if (p.image_path) { %><img class="thumb" src="<%= p.image_path %>" alt="" loading="lazy"/><% } else { %><span class="thumb thumb--empty">J</span><% } %><span><strong><%= p.name_en %></strong></span></a></td>
          <td class="muted"><%= p.brand %></td>
          <td><span class="input-affix"><input type="number" name="prices[<%= p.id %>]" value="<%= p.price != null ? p.price : '' %>" min="0" step="1000" placeholder="<%= a('not_set') %>" dir="ltr" data-price/><span>LBP</span></span></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</form>
<script>
  document.getElementById('setAllBtn').addEventListener('click', function () {
    var v = document.getElementById('setAllValue').value;
    if (v === '') return;
    document.querySelectorAll('[data-price]').forEach(function (i) { i.value = v; });
  });
</script>
<%- include('../partials/admin-footer') %>
