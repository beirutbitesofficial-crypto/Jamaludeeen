<%- include('../partials/admin-header', { title: title }) %>

<div class="admin-page">
  <div class="admin-page__header">
    <div>
      <a href="/admin/brands" class="back-link">← Brands</a>
      <h1 class="admin-page__title">
        <% if (brand.logo_path) { %><img src="<%= brand.logo_path %>" style="height:32px;object-fit:contain;vertical-align:middle;margin-right:10px"/><% } %>
        <%= brand.name %> — Categories
      </h1>
    </div>
    <a href="/collections/<%= brand.id %>" target="_blank" class="btn btn--outline btn--sm">View on Store ↗</a>
  </div>

  <!-- Add category form -->
  <div class="settings-card" style="margin-bottom:28px">
    <h3 class="panel-title">Add New Category</h3>
    <form action="/admin/brands/<%= brand.id %>/categories/new" method="POST" style="display:flex;gap:14px;flex-wrap:wrap;align-items:flex-end">
      <div class="form-group" style="flex:1;min-width:160px;margin-bottom:0">
        <label class="form-label">Name (English) *</label>
        <input type="text" name="name_en" class="form-input" required placeholder="e.g. Men's Collection"/>
      </div>
      <div class="form-group" style="flex:1;min-width:160px;margin-bottom:0">
        <label class="form-label">Name (Arabic)</label>
        <input type="text" name="name_ar" class="form-input" dir="rtl" placeholder="مجموعة الرجال"/>
      </div>
      <div class="form-group" style="width:100px;margin-bottom:0">
        <label class="form-label">Sort Order</label>
        <input type="number" name="sort_order" class="form-input" value="0" min="0"/>
      </div>
      <button type="submit" class="btn btn--primary">+ Add Category</button>
    </form>
  </div>

  <!-- Categories table -->
  <% if (categories.length) { %>
  <div class="table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Image</th>
          <th>Name (EN)</th>
          <th>Name (AR)</th>
          <th>Sort</th>
          <th>Products</th>
          <th>Manage Products</th>
          <th>Edit</th>
          <th>Delete</th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach(cat => { %>
        <tr>
          <td>
            <% if (cat.image_path) { %>
              <img src="<%= cat.image_path %>" class="table-thumb" alt=""/>
            <% } else { %>
              <div class="table-thumb table-thumb--empty">✦</div>
            <% } %>
          </td>
          <td><strong><%= cat.name_en %></strong></td>
          <td dir="rtl"><%= cat.name_ar || '—' %></td>
          <td><%= cat.sort_order %></td>
          <td><%= cat.product_count %></td>
          <td>
            <a href="/admin/brands/<%= brand.id %>/categories/<%= cat.id %>/products" class="btn-sm">Manage Products</a>
          </td>
          <td>
            <button class="btn-sm btn-edit-cat"
              data-id="<%= cat.id %>"
              data-name="<%= cat.name_en %>"
              data-name-ar="<%= cat.name_ar || '' %>"
              data-sort="<%= cat.sort_order %>">Edit</button>
          </td>
          <td>
            <form method="POST" action="/admin/brands/<%= brand.id %>/categories/<%= cat.id %>/delete"
                  onsubmit="return confirm('Delete this category? Products will be unlinked but not deleted.')">
              <button type="submit" class="btn-sm btn-sm--danger">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="empty-state" style="padding:48px 0">
    <p class="empty-state__icon">📂</p>
    <h3>No categories yet</h3>
    <p>Add a category above to get started.</p>
  </div>
  <% } %>
</div>

<!-- Edit modal -->
<div class="modal" id="editModal" style="display:none">
  <div class="modal__box">
    <h3>Edit Category</h3>
    <form id="editForm" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label class="form-label">Name (English) *</label>
        <input type="text" name="name_en" id="edit_name_en" class="form-input" required/>
      </div>
      <div class="form-group">
        <label class="form-label">Name (Arabic)</label>
        <input type="text" name="name_ar" id="edit_name_ar" class="form-input" dir="rtl"/>
      </div>
      <div class="form-group">
        <label class="form-label">Sort Order</label>
        <input type="number" name="sort_order" id="edit_sort" class="form-input" min="0"/>
      </div>
      <div class="form-group">
        <label class="form-label">Category Image</label>
        <input type="file" name="image" accept="image/jpeg,image/png,image/webp" class="form-input"/>
        <p class="form-hint">JPG/PNG/WebP — max 5MB</p>
      </div>
      <div class="modal__actions">
        <button type="button" class="btn btn--outline" onclick="document.getElementById('editModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn--primary">💾 Save</button>
      </div>
    </form>
  </div>
</div>

<script>
document.querySelectorAll('.btn-edit-cat').forEach(btn => {
  btn.addEventListener('click', () => {
    document.getElementById('edit_name_en').value  = btn.dataset.name;
    document.getElementById('edit_name_ar').value  = btn.dataset.nameAr;
    document.getElementById('edit_sort').value     = btn.dataset.sort;
    document.getElementById('editForm').action     = `/admin/brands/<%= brand.id %>/categories/${btn.dataset.id}/edit`;
    document.getElementById('editModal').style.display = 'flex';
  });
});
</script>

<%- include('../partials/admin-footer') %>
