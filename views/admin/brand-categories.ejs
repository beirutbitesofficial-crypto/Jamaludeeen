<%- include('../partials/admin-header', { title: brand.name }) %>
<a class="bo-back" href="/admin/brands"><%- icon('back') %><%= a('brands') %></a>
<div class="bo-head">
  <div><p class="bo-kicker"><%= a('brand_lines') %></p><h1><%= brand.name %></h1></div>
  <div class="bo-head__actions">
    <a class="btn" href="/admin/products?section=brands&brand=<%= encodeURIComponent(brand.name) %>"><%- icon('bottle') %><%= a('products') %></a>
    <button class="btn btn--dark" data-open="newLine"><%- icon('plus') %><%= a('add_line') %></button>
  </div>
</div>

<section class="card">
  <% if (!categories.length) { %><div class="empty-block"><%- icon('lines') %><p><%= a('no_results') %></p></div><% } %>
  <% categories.forEach(c => { %>
  <div class="list-row">
    <a class="prod-cell" href="/admin/brands/<%= brand.id %>/categories/<%= c.id %>/products">
      <% if (c.image_path) { %><img class="thumb" src="<%= c.image_path %>" alt=""/><% } else { %><span class="thumb thumb--empty">J</span><% } %>
      <span><strong><%= c.name_en %></strong><small><span class="num"><%= c.product_count %></span> <%= a('products') %><%= c.name_ar ? ' · ' + c.name_ar : '' %></small></span>
    </a>
    <span class="tile__actions" style="margin:0">
      <a class="btn btn--sm btn--dark" href="/admin/brands/<%= brand.id %>/categories/<%= c.id %>/products"><%= a('manage') %></a>
      <button class="btn btn--sm btn--ghost" data-open="editLine<%= c.id %>"><%- icon('edit') %></button>
    </span>
  </div>
  <div class="modal" id="editLine<%= c.id %>">
    <div class="modal__box">
      <div class="modal__head"><h3><%= a('edit_line') %></h3><button class="modal__close" data-close><%- icon('x') %></button></div>
      <div class="modal__body form">
        <form class="form" action="/admin/brands/<%= brand.id %>/categories/<%= c.id %>/edit" method="POST" enctype="multipart/form-data">
          <label class="field"><span><%= a('name_en') %></span><input name="name_en" value="<%= c.name_en %>" required/></label>
          <label class="field"><span><%= a('name_ar') %></span><input name="name_ar" value="<%= c.name_ar || '' %>" dir="rtl"/></label>
          <label class="field"><span><%= a('sort_order') %></span><input type="number" name="sort_order" value="<%= c.sort_order || 0 %>" dir="ltr"/></label>
          <label class="field"><span><%= a('image') %> <small>(<%= a('optional') %>)</small></span><input type="file" name="image" accept="image/jpeg,image/png,image/webp"/></label>
          <button class="btn btn--dark btn--block" type="submit"><%= a('save_changes') %></button>
        </form>
        <form action="/admin/brands/<%= brand.id %>/categories/<%= c.id %>/delete" method="POST" data-confirm="<%= a('confirm_delete') %>">
          <button class="btn btn--ghost btn--danger btn--block" type="submit"><%- icon('trash') %><%= a('delete') %></button>
        </form>
      </div>
    </div>
  </div>
  <% }) %>
</section>

<div class="modal" id="newLine">
  <div class="modal__box">
    <div class="modal__head"><h3><%= a('add_line') %></h3><button class="modal__close" data-close><%- icon('x') %></button></div>
    <form class="modal__body form" action="/admin/brands/<%= brand.id %>/categories/new" method="POST">
      <label class="field"><span><%= a('name_en') %></span><input name="name_en" required/></label>
      <label class="field"><span><%= a('name_ar') %> <small>(<%= a('optional') %>)</small></span><input name="name_ar" dir="rtl"/></label>
      <label class="field"><span><%= a('sort_order') %></span><input type="number" name="sort_order" value="0" dir="ltr"/></label>
      <button class="btn btn--dark btn--block" type="submit"><%- icon('plus') %><%= a('create') %></button>
    </form>
  </div>
</div>
<%- include('../partials/admin-footer') %>
