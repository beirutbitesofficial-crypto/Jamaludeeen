<%- include('../partials/admin-header', { title: a('products') }) %>
<%
  const qs = o => new URLSearchParams(Object.fromEntries(Object.entries(Object.assign({}, filters, o)).filter(([, v]) => v !== '' && v != null))).toString();
  const isBrand = filters.section === 'brands';
%>
<div class="bo-head">
  <div>
    <p class="bo-kicker"><%= a('catalog') %></p>
    <h1><%= a('products') %></h1>
    <p><%= isBrand ? a('brand_note') : a('refill_note') %></p>
  </div>
  <div class="bo-head__actions">
    <a class="btn" href="/<%= isBrand ? 'collections' : 'shop/' + filters.section %>" target="_blank"><%- icon('external') %><%= a('view_on_store') %></a>
    <button class="btn btn--dark" data-open="newProduct"><%- icon('plus') %><%= a('add_product') %></button>
  </div>
</div>

<nav class="tabs" aria-label="<%= a('section') %>">
  <% ['men','women','unisex','brands'].forEach(k => { %>
  <a href="/admin/products?section=<%= k %>" class="<%= filters.section === k ? 'is-active' : '' %>"><%= a(k) %><span class="tabs__count num"><%= counts[k] %></span></a>
  <% }) %>
</nav>

<% if (isBrand) { %>
<div class="chips chips--scroll" style="margin-top:14px">
  <a class="chip <%= !filters.brand ? 'is-active' : '' %>" href="?<%= qs({ brand: '', page: '' }) %>"><%= a('all_brands') %></a>
  <% brands.forEach(b => { %><a class="chip <%= filters.brand === b.name ? 'is-active' : '' %>" href="?<%= qs({ brand: b.name, page: '' }) %>"><%= b.name %> <small class="num"><%= b.count %></small></a><% }) %>
</div>
<% } %>

<form class="toolbar" method="GET" action="/admin/products">
  <input type="hidden" name="section" value="<%= filters.section %>"/>
  <% if (filters.brand) { %><input type="hidden" name="brand" value="<%= filters.brand %>"/><% } %>
  <label class="search toolbar__grow"><%- icon('search') %><input type="search" name="q" value="<%= filters.q %>" placeholder="<%= a('search') %>…"/></label>
  <select name="photo" class="input" style="width:auto" onchange="this.form.submit()">
    <option value=""><%= a('all') %> · <%= a('images') %></option>
    <option value="with" <%= filters.photo === 'with' ? 'selected' : '' %>><%= a('with_photo') %></option>
    <option value="without" <%= filters.photo === 'without' ? 'selected' : '' %>><%= a('without_photo') %></option>
  </select>
  <button class="btn" type="submit"><%= a('search') %></button>
  <% if (filters.q || filters.photo) { %><a class="btn btn--ghost" href="?<%= qs({ q: '', photo: '', page: '' }) %>"><%= a('clear') %></a><% } %>
</form>

<section class="card">
  <div class="table-wrap">
    <table class="table table-cards">
      <thead><tr><th><%= a('product') %></th><th><%= isBrand ? a('brand') : a('original_house') %></th><th><%= a('price') %></th><th><%= a('status') %></th><th></th></tr></thead>
      <tbody>
        <% if (!products.length) { %><tr><td colspan="5" class="empty"><%= a('no_results') %></td></tr><% } %>
        <% products.forEach(p => { %>
        <tr>
          <td>
            <a href="/admin/products/<%= p.id %>/edit" class="prod-cell">
              <% if (p.image_path) { %><img class="thumb" src="<%= p.image_path %>" alt="" loading="lazy"/><% } else { %><span class="thumb thumb--empty">J</span><% } %>
              <span><strong><%= p.name_en %></strong><% if (p.name_ar) { %><small dir="rtl"><%= p.name_ar %></small><% } %></span>
            </a>
          </td>
          <td data-hide-mobile><%= p.brand %></td>
          <td class="num" dir="ltr">
            <% if (p.type === 'local') { %>$<%= refill[50] %> · $<%= refill[100] %>
            <% } else if (p.price) { %><%= money(p.price, 'LBP') %>
            <% } else { %><span class="muted"><%= a('not_set') %></span><% } %>
          </td>
          <td>
            <span class="pill <%= p.in_stock ? 'pill--green' : 'pill--red' %>"><%= p.in_stock ? a('available') : a('unavailable') %></span>
            <% if (p.featured) { %><span class="pill pill--gold pill--plain"><%= a('featured') %></span><% } %>
          </td>
          <td class="actions"><a href="/admin/products/<%= p.id %>/edit" class="btn btn--sm"><%- icon('edit') %><%= a('edit') %></a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (pagination.totalPages > 1) { %>
  <div class="pager">
    <span class="num"><%= a('page') %> <%= pagination.page %> <%= a('of') %> <%= pagination.totalPages %> · <%= pagination.total %> <%= a('items') %></span>
    <span class="pager__links">
      <% if (pagination.page > 1) { %><a class="btn btn--sm" href="?<%= qs({ page: pagination.page - 1 }) %>"><%= a('prev') %></a><% } %>
      <% if (pagination.page < pagination.totalPages) { %><a class="btn btn--sm" href="?<%= qs({ page: pagination.page + 1 }) %>"><%= a('next') %></a><% } %>
    </span>
  </div>
  <% } %>
</section>

<%- include('partials/new-product-modal', { defaultSection: filters.section, defaultBrand: filters.brand }) %>
<%- include('../partials/admin-footer') %>
