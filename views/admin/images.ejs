<%- include('../partials/admin-header', { title: a('images') }) %>
<%
  const qs = o => new URLSearchParams(Object.fromEntries(Object.entries(Object.assign({}, filters, o)).filter(([, v]) => v !== '' && v != null))).toString();
  const siteImgs = [
    { key: 'banner', label: a('hero_image') },
    { key: 'men', label: a('collection_cover') + ' · ' + a('men') },
    { key: 'women', label: a('collection_cover') + ' · ' + a('women') },
    { key: 'unisex', label: a('collection_cover') + ' · ' + a('unisex') },
  ];
%>
<div class="bo-head">
  <div>
    <p class="bo-kicker"><%= a('catalog') %></p>
    <h1><%= a('images') %></h1>
    <p><%= a('images_intro') %></p>
  </div>
</div>

<section class="card" style="margin-bottom:24px">
  <div class="card__head"><h2><%- icon('image') %> <%= a('homepage_images') %></h2></div>
  <div class="card__body img-grid">
    <% siteImgs.forEach(s => { const src = settings[s.key + '_image']; %>
    <div class="img-card">
      <div class="img-card__media"><% if (src) { %><img src="<%= src %>" alt="" style="object-fit:cover"/><% } else { %><span class="monogram">J</span><% } %></div>
      <div class="img-card__body">
        <strong><%= s.label %></strong>
        <form action="/admin/settings/upload-image/<%= s.key %>" method="POST" enctype="multipart/form-data">
          <label class="btn btn--sm btn--block upload"><%- icon('upload') %><%= src ? a('change') : a('upload') %><input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-autosubmit/></label>
        </form>
        <% if (src && src.startsWith('/uploads/')) { %>
        <form action="/admin/settings/delete-image/<%= s.key %>" method="POST" data-confirm="<%= a('confirm_delete') %>"><button class="btn btn--sm btn--ghost btn--danger btn--block"><%- icon('trash') %><%= a('remove') %></button></form>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<nav class="tabs">
  <% ['men','women','unisex','brands'].forEach(k => { %>
  <a href="/admin/images?section=<%= k %>" class="<%= filters.section === k ? 'is-active' : '' %>"><%= a(k) %><span class="tabs__count num"><%= counts[k] %></span></a>
  <% }) %>
</nav>

<% if (filters.section === 'brands') { %>
<div class="chips chips--scroll" style="margin-top:14px">
  <a class="chip <%= !filters.brand ? 'is-active' : '' %>" href="?<%= qs({ brand: '', page: '' }) %>"><%= a('all_brands') %></a>
  <% brands.forEach(b => { %><a class="chip <%= filters.brand === b.name ? 'is-active' : '' %>" href="?<%= qs({ brand: b.name, page: '' }) %>"><%= b.name %></a><% }) %>
</div>
<% } %>

<div class="chips" style="margin:14px 0">
  <a class="chip <%= !filters.photo ? 'is-active' : '' %>" href="?<%= qs({ photo: '', page: '' }) %>"><%= a('all') %></a>
  <a class="chip <%= filters.photo === 'without' ? 'is-active' : '' %>" href="?<%= qs({ photo: 'without', page: '' }) %>"><%= a('without_photo') %></a>
  <a class="chip <%= filters.photo === 'with' ? 'is-active' : '' %>" href="?<%= qs({ photo: 'with', page: '' }) %>"><%= a('with_photo') %></a>
  <span class="muted num" style="margin-inline-start:auto"><%= pagination.total %> <%= a('items') %></span>
</div>

<% if (!products.length) { %>
<div class="card empty-block"><%- icon('image') %><p><%= a('no_results') %></p></div>
<% } else { %>
<div class="img-grid">
  <% products.forEach(p => { %>
  <div class="img-card">
    <a class="img-card__media" href="/admin/products/<%= p.id %>/edit">
      <% if (p.image_path) { %><img src="<%= p.image_path %>" alt="" loading="lazy"/><span class="img-card__ok"><%- icon('check') %></span><% } else { %><span class="monogram">J</span><% } %>
    </a>
    <div class="img-card__body">
      <small><%= p.brand %></small>
      <strong><%= p.name_en %></strong>
      <form action="/admin/products/<%= p.id %>/image" method="POST" enctype="multipart/form-data">
        <label class="btn btn--sm btn--block upload <%= p.image_path ? '' : 'btn--dark' %>"><%- icon('upload') %><%= p.image_path ? a('change') : a('upload') %><input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-autosubmit/></label>
      </form>
    </div>
  </div>
  <% }) %>
</div>
<% } %>

<% if (pagination.totalPages > 1) { %>
<div class="pager">
  <span class="num"><%= a('page') %> <%= pagination.page %> <%= a('of') %> <%= pagination.totalPages %></span>
  <span class="pager__links">
    <% if (pagination.page > 1) { %><a class="btn btn--sm" href="?<%= qs({ page: pagination.page - 1 }) %>"><%= a('prev') %></a><% } %>
    <% if (pagination.page < pagination.totalPages) { %><a class="btn btn--sm" href="?<%= qs({ page: pagination.page + 1 }) %>"><%= a('next') %></a><% } %>
  </span>
</div>
<% } %>
<%- include('../partials/admin-footer') %>
