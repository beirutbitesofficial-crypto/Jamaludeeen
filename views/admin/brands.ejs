<%- include('../partials/admin-header', { title: a('brands') }) %>
<div class="bo-head">
  <div><p class="bo-kicker"><%= a('catalog') %></p><h1><%= a('brands') %></h1><p><%= a('brand_note') %></p></div>
  <div class="bo-head__actions"><button class="btn btn--dark" data-open="newBrand"><%- icon('plus') %><%= a('add_brand') %></button></div>
</div>

<% if (!brands.length) { %><div class="card empty-block"><%- icon('tag') %><p><%= a('no_results') %></p></div><% } %>
<div class="grid grid--3">
  <% brands.forEach(b => { %>
  <article class="card tile">
    <div class="tile__media" <% if (b.logo_path) { %>style="background-image:url('<%= b.logo_path %>')"<% } %>><span><%= b.name %></span></div>
    <div class="tile__body">
      <div class="tile__meta">
        <span><b class="num"><%= b.product_count %></b> <%= a('products') %> · <b class="num"><%= b.line_count %></b> <%= a('lines') %></span>
        <span class="pill pill--plain"><%= a(b.type || 'western') %></span>
      </div>
      <% if (b.name_ar) { %><small class="muted" dir="rtl"><%= b.name_ar %></small><% } %>
      <div class="tile__actions">
        <a class="btn btn--sm btn--dark" href="/admin/products?section=brands&brand=<%= encodeURIComponent(b.name) %>"><%- icon('bottle') %><%= a('products') %></a>
        <a class="btn btn--sm" href="/admin/brands/<%= b.id %>/categories"><%- icon('lines') %><%= a('lines') %></a>
        <button class="btn btn--sm btn--ghost" data-open="editBrand<%= b.id %>"><%- icon('edit') %></button>
      </div>
    </div>
  </article>

  <div class="modal" id="editBrand<%= b.id %>">
    <div class="modal__box">
      <div class="modal__head"><h3><%= a('edit_brand') %> · <%= b.name %></h3><button class="modal__close" data-close><%- icon('x') %></button></div>
      <div class="modal__body form">
        <form action="/admin/brands/<%= b.id %>/edit" method="POST" class="form">
          <label class="field"><span><%= a('name_en') %></span><input name="name" value="<%= b.name %>" required/></label>
          <label class="field"><span><%= a('name_ar') %></span><input name="name_ar" value="<%= b.name_ar || '' %>" dir="rtl"/></label>
          <label class="field"><span><%= a('brand_type') %></span><select name="type"><option value="western" <%= b.type !== 'khaleeji' ? 'selected' : '' %>><%= a('western') %></option><option value="khaleeji" <%= b.type === 'khaleeji' ? 'selected' : '' %>><%= a('khaleeji') %></option></select></label>
          <button class="btn btn--dark btn--block" type="submit"><%= a('save_changes') %></button>
        </form>
        <form action="/admin/brands/<%= b.id %>/logo" method="POST" enctype="multipart/form-data">
          <label class="btn btn--block upload"><%- icon('upload') %><%= a('logo') %> — <%= b.logo_path ? a('change') : a('upload') %><input type="file" name="logo" accept="image/jpeg,image/png,image/webp" data-autosubmit/></label>
        </form>
        <form action="/admin/brands/<%= b.id %>/delete" method="POST" data-confirm="<%= a('brand_delete_confirm') %>">
          <button class="btn btn--ghost btn--danger btn--block" type="submit"><%- icon('trash') %><%= a('delete') %></button>
        </form>
      </div>
    </div>
  </div>
  <% }) %>
</div>

<div class="modal" id="newBrand">
  <div class="modal__box">
    <div class="modal__head"><h3><%= a('add_brand') %></h3><button class="modal__close" data-close><%- icon('x') %></button></div>
    <form class="modal__body form" action="/admin/brands/new" method="POST">
      <label class="field"><span><%= a('name_en') %></span><input name="name" required/></label>
      <label class="field"><span><%= a('name_ar') %> <small>(<%= a('optional') %>)</small></span><input name="name_ar" dir="rtl"/></label>
      <label class="field"><span><%= a('brand_type') %></span><select name="type"><option value="western"><%= a('western') %></option><option value="khaleeji"><%= a('khaleeji') %></option></select></label>
      <button class="btn btn--dark btn--block" type="submit"><%- icon('plus') %><%= a('create') %></button>
    </form>
  </div>
</div>
<%- include('../partials/admin-footer') %>
