<%- include('../partials/admin-header', { title: a('dashboard') }) %>
<div class="bo-head">
  <div>
    <p class="bo-kicker"><%= new Date().toLocaleDateString(a.lang === 'ar' ? 'ar-LB' : 'en-GB', { weekday: 'long', day: 'numeric', month: 'long' }) %></p>
    <h1><%= a('welcome') %></h1>
    <p><%= a('today_glance') %></p>
  </div>
  <div class="bo-head__actions">
    <a href="/system" class="btn btn--gold"><%- icon('pos') %><%= a('open_pos') %></a>
    <a href="/" target="_blank" class="btn"><%- icon('store') %><%= a('view_store') %></a>
  </div>
</div>

<div class="grid grid--4">
  <a href="/admin/orders?status=pending" class="card stat <%= stats.pending ? 'stat--alert' : '' %>">
    <span class="stat__label"><span class="stat__icon"><%- icon('clock') %></span><%= a('pending_orders') %></span>
    <span class="stat__value num" data-pending-count><%= stats.pending %></span>
  </a>
  <a href="/admin/orders" class="card stat">
    <span class="stat__label"><span class="stat__icon"><%- icon('receipt') %></span><%= a('total_orders') %></span>
    <span class="stat__value num"><%= stats.orders.toLocaleString('en-US') %></span>
  </a>
  <div class="card stat">
    <span class="stat__label"><span class="stat__icon"><%- icon('coin') %></span><%= a('website_revenue') %></span>
    <span class="stat__value num" dir="ltr"><%= money(stats.revenue, 'LBP') %></span>
    <small dir="ltr">≈ <%= money(stats.revenue / usdRate, 'USD') %></small>
  </div>
  <a href="/admin/catalog" class="card stat">
    <span class="stat__label"><span class="stat__icon"><%- icon('bottle') %></span><%= a('total_products') %></span>
    <span class="stat__value num"><%= stats.products.toLocaleString('en-US') %></span>
    <% if (missingPhotos) { %><small><%= missingPhotos %> <%= a('without_photo').toLowerCase() %></small><% } %>
  </a>
</div>

<div class="grid grid--side">
  <section class="card">
    <div class="card__head"><h2><%= a('recent_orders') %></h2><a href="/admin/orders" class="btn btn--sm btn--ghost"><%= a('view_all') %><%- icon('arrow', 'ico-flip') %></a></div>
    <div class="table-wrap">
      <table class="table table-cards">
        <thead><tr><th><%= a('order') %></th><th><%= a('customer') %></th><th><%= a('total') %></th><th><%= a('status') %></th><th></th></tr></thead>
        <tbody>
          <% if (!recentOrders.length) { %><tr><td colspan="5" class="empty"><%= a('no_orders') %></td></tr><% } %>
          <% recentOrders.forEach(o => { %>
          <tr>
            <td><strong class="num"><%= o.order_number %></strong><br/><small class="muted"><%= new Date(o.created_at + 'Z').toLocaleString(a.lang === 'ar' ? 'ar-LB' : 'en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %></small></td>
            <td data-hide-mobile><%= o.customer_name %><br/><small class="muted"><%= o.customer_city %></small></td>
            <td class="num" dir="ltr"><strong><%= money(o.total, o.currency || 'LBP') %></strong></td>
            <td><span class="pill st-<%= o.status %>"><%= a('st_' + o.status) %></span></td>
            <td class="actions"><a href="/admin/orders/<%= o.id %>" class="btn btn--sm"><%= a('view') %></a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <aside class="card">
    <div class="card__head"><h2><%= a('collections') %></h2><a href="/admin/catalog" class="btn btn--sm btn--ghost"><%= a('manage') %></a></div>
    <% ['men','women','unisex','brands'].forEach(k => { %>
    <a class="list-row" href="/admin/products?section=<%= k %>">
      <span style="display:flex;align-items:center;gap:10px"><span class="stat__icon"><%- icon(k === 'brands' ? 'tag' : 'bottle') %></span><%= a(k) %></span>
      <span class="pill pill--plain num"><%= counts[k] %></span>
    </a>
    <% }) %>
    <div class="card__body" style="display:grid;gap:8px;border-top:1px solid var(--line)">
      <a href="/admin/prices" class="btn btn--block"><%- icon('coin') %><%= a('prices') %></a>
      <a href="/admin/images?photo=without" class="btn btn--block"><%- icon('image') %><%= a('images') %></a>
    </div>
  </aside>
</div>
<%- include('../partials/admin-footer') %>
