<%- include('../partials/admin-header', { title: a('collections') }) %>
<div class="bo-head">
  <div>
    <p class="bo-kicker"><%= a('catalog') %></p>
    <h1><%= a('collections') %></h1>
    <p><%= a('catalog_intro') %></p>
  </div>
  <div class="bo-head__actions">
    <button class="btn btn--dark" data-open="newProduct"><%- icon('plus') %><%= a('add_product') %></button>
  </div>
</div>

<div class="grid grid--4">
  <% ['men','women','unisex'].forEach(k => { %>
  <article class="card tile">
    <div class="tile__media" <% if (covers[k]) { %>style="background-image:url('<%= covers[k] %>')"<% } %>><span><%= a(k) %></span></div>
    <div class="tile__body">
      <div class="tile__meta"><span><%= a('products') %></span><b class="num"><%= counts[k] %></b></div>
      <div class="tile__meta"><span>50 / 100 ml</span><b dir="ltr">$<%= refill[50] %> · $<%= refill[100] %></b></div>
      <div class="tile__actions">
        <a href="/admin/products?section=<%= k %>" class="btn btn--dark btn--sm"><%= a('manage') %></a>
        <a href="/admin/images?section=<%= k %>" class="btn btn--sm"><%= a('images') %></a>
        <a href="/shop/<%= k %>" target="_blank" class="btn btn--sm btn--ghost"><%- icon('external') %></a>
      </div>
    </div>
  </article>
  <% }) %>
  <article class="card tile">
    <div class="tile__media"><span><%= a('brands') %></span></div>
    <div class="tile__body">
      <div class="tile__meta"><span><%= a('products') %></span><b class="num"><%= counts.brands %></b></div>
      <div class="tile__meta"><span><%= a('brands') %></span><b class="num"><%= brands.length %></b></div>
      <div class="tile__actions">
        <a href="/admin/products?section=brands" class="btn btn--dark btn--sm"><%= a('manage') %></a>
        <a href="/admin/brands" class="btn btn--sm"><%= a('brands') %></a>
        <a href="/collections" target="_blank" class="btn btn--sm btn--ghost"><%- icon('external') %></a>
      </div>
    </div>
  </article>
</div>

<div class="grid grid--2">
  <div class="note"><%- icon('bottle') %><span><%= a('refill_note') %></span></div>
  <div class="note"><%- icon('tag') %><span><%= a('brand_note') %></span></div>
</div>

<section class="card">
  <div class="card__head"><h2><%= a('brands') %></h2><a href="/admin/brands" class="btn btn--sm btn--ghost"><%= a('manage') %></a></div>
  <div class="card__body chips">
    <% brands.forEach(b => { %><a class="chip" href="/admin/products?section=brands&brand=<%= encodeURIComponent(b.name) %>"><%= b.name %> <small class="num"><%= b.count %></small></a><% }) %>
  </div>
</section>

<%- include('partials/new-product-modal') %>
<%- include('../partials/admin-footer') %>
