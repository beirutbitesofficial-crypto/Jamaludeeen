<%- include('partials/header', { title: title }) %>
<% const ar = lang === 'ar';
   const titles = { men: t.men_perfumes, women: t.women_perfumes, unisex: t.unisex_perfumes };
   const intros = {
     men: ar ? 'عطور رجالية بطابع واثق — من الأخشاب والعود إلى النفحات المنعشة.' : 'Assured compositions for him — from woods and oud to crisp, luminous freshness.',
     women: ar ? 'عطور نسائية راقية — زهور، مسك، وحلاوة ناعمة.' : 'Graceful signatures for her — florals, musks and soft, luminous sweetness.',
     unisex: ar ? 'عطور بلا حدود، لكل من يبحث عن التميّز.' : 'Fragrances without borders, for anyone drawn to the extraordinary.',
   };
   const pageLink = n => `/shop/${filters.category}?${new URLSearchParams(Object.assign({}, filters.q ? { q: filters.q } : {}, { page: n })).toString()}`; %>

<main>
  <section class="page-hero">
    <div class="container">
      <nav class="crumbs"><a href="/"><%= t.home %></a><span>/</span><span><%= titles[filters.category] %></span></nav>
      <div class="page-hero__row">
        <div>
          <p class="eyebrow"><span></span><%= ar ? 'مجموعة جمال الدين' : 'The Jamaludeen Collection' %></p>
          <h1 class="display display--xl"><%= titles[filters.category] || t.all_perfumes %></h1>
          <p class="page-hero__lede"><%= intros[filters.category] %></p>
        </div>
        <div class="page-hero__price">
          <span>50 ml</span><strong>$7</strong>
          <span>100 ml</span><strong>$13</strong>
        </div>
      </div>
      <nav class="tabs" aria-label="Collections">
        <a href="/shop/men" class="<%= filters.category === 'men' ? 'is-active' : '' %>"><%= t.men %></a>
        <a href="/shop/women" class="<%= filters.category === 'women' ? 'is-active' : '' %>"><%= t.women %></a>
        <a href="/shop/unisex" class="<%= filters.category === 'unisex' ? 'is-active' : '' %>"><%= t.unisex %></a>
        <a href="/collections"><%= t.brands %></a>
      </nav>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <div class="toolbar">
        <form method="GET" action="/shop/<%= filters.category %>" class="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" name="q" value="<%= filters.q || '' %>" placeholder="<%= ar ? 'ابحث عن عطر أو ماركة...' : 'Search a perfume or house…' %>" aria-label="Search"/>
          <button type="submit"><%= ar ? 'بحث' : 'Search' %></button>
        </form>
        <p class="toolbar__count">
          <% if (filters.q) { %>
            <%= pagination.total %> <%= ar ? 'نتيجة لـ' : 'results for' %> “<%= filters.q %>” · <a href="/shop/<%= filters.category %>"><%= ar ? 'مسح' : 'Clear' %></a>
          <% } else { %>
            <%= pagination.total %> <%= t.products %>
          <% } %>
        </p>
      </div>

      <% if (!products.length) { %>
        <div class="empty">
          <span class="empty__mark">J</span>
          <h2><%= t.no_products %></h2>
          <p><%= ar ? 'جرّب بحث مختلف أو تصفّح فئة ثانية.' : 'Try another search or browse a different collection.' %></p>
          <a href="/shop/<%= filters.category %>" class="btn btn--dark"><%= ar ? 'مسح البحث' : 'Clear search' %></a>
        </div>
      <% } else { %>
        <div class="grid-products grid-products--catalog">
          <% products.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %>
        </div>

        <% if (pagination.totalPages > 1) { %>
        <nav class="pager" aria-label="Pagination">
          <% if (pagination.page > 1) { %><a href="<%= pageLink(pagination.page - 1) %>" class="pager__step">← <%= t.prev %></a><% } else { %><span class="pager__step is-disabled">← <%= t.prev %></span><% } %>
          <span class="pager__info"><em><%= pagination.page %></em> / <%= pagination.totalPages %></span>
          <% if (pagination.page < pagination.totalPages) { %><a href="<%= pageLink(pagination.page + 1) %>" class="pager__step"><%= t.next_page %> →</a><% } else { %><span class="pager__step is-disabled"><%= t.next_page %> →</span><% } %>
        </nav>
        <% } %>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
