<%- include('partials/header', { title: title }) %>

<div class="shop-page">
  <div class="container">

    <!-- Page header -->
    <div class="page-header">
      <p class="page-header__eyebrow">JAMALUDEEN COLLECTION</p>
      <h1 class="page-header__title">
        <% if (filters.category === 'men') { %><%= t.men_perfumes %>
        <% } else if (filters.category === 'women') { %><%= t.women_perfumes %>
        <% } else if (filters.category === 'unisex') { %><%= t.unisex_perfumes %>
        <% } else { %><%= t.all_perfumes %><% } %>
      </h1>
      <p class="page-header__count"><%= pagination.total %> <%= t.products %></p>
      <nav class="collection-tabs" aria-label="Catalog categories">
        <a href="/shop/men" class="<%= filters.category === 'men' ? 'active' : '' %>"><%= t.men %></a>
        <a href="/shop/women" class="<%= filters.category === 'women' ? 'active' : '' %>"><%= t.women %></a>
        <a href="/shop/unisex" class="<%= filters.category === 'unisex' ? 'active' : '' %>"><%= t.unisex %></a>
        <a href="/collections"><%= lang === 'ar' ? 'الماركات' : 'Brands' %></a>
      </nav>
    </div>

    <form method="GET" action="/shop/<%= filters.category %>" class="catalog-toolbar" id="filterForm">
      <label class="catalog-search">
        <span class="catalog-search__label"><%= lang === 'ar' ? 'بحث في المجموعة' : 'Search the collection' %></span>
        <span class="catalog-search__row">
          <input type="search" name="q" value="<%= filters.q || '' %>" placeholder="<%= t.search_placeholder %>" class="catalog-search__input"/>
          <button type="submit" class="catalog-search__button"><%= lang === 'ar' ? 'بحث' : 'Search' %></button>
        </span>
      </label>
      <% if (filters.q) { %><a href="/shop/<%= filters.category %>" class="catalog-clear"><%= lang === 'ar' ? 'مسح البحث' : 'Clear search' %></a><% } %>
    </form>

    <div class="shop-layout shop-layout--catalog">

      <!-- Filters sidebar -->
      <aside class="shop-sidebar catalog-category-panel" id="shopSidebar">
        <div class="shop-sidebar__inner">
          <h3 class="shop-sidebar__title"><%= lang === 'ar' ? 'تسوّق حسب الفئة' : 'Shop by category' %></h3>

          <div>
            <div class="filter-group">
              <label class="filter-label"><%= lang === 'ar' ? 'الفئة' : 'Category' %></label>
              <div class="filter-options">
                <a href="/shop/men<%= filters.q ? '?q='+encodeURIComponent(filters.q) : '' %>"
                   class="filter-option <%= filters.category === 'men' ? 'active' : '' %>"><%= t.men %></a>
                <a href="/shop/women<%= filters.q ? '?q='+encodeURIComponent(filters.q) : '' %>"
                   class="filter-option <%= filters.category === 'women' ? 'active' : '' %>"><%= t.women %></a>
                <a href="/shop/unisex<%= filters.q ? '?q='+encodeURIComponent(filters.q) : '' %>"
                   class="filter-option <%= filters.category === 'unisex' ? 'active' : '' %>"><%= t.unisex %></a>
              </div>
            </div>

          </div>
        </div>
      </aside>

      <!-- Products grid -->
      <main class="shop-main">
        <!-- Mobile filter toggle -->
        <button class="shop-filter-toggle" id="filterToggle">
          <%= lang === 'ar' ? 'اختيار الفئة' : 'Choose category' %>
        </button>

        <% if (!products.length) { %>
        <div class="empty-state">
          <p class="empty-state__icon">✦</p>
          <h3><%= t.no_products %></h3>
          <a href="/shop/<%= filters.category %>" class="btn btn--outline"><%= lang === 'ar' ? 'مسح الفلتر' : 'Clear filters' %></a>
        </div>
        <% } else { %>
        <div class="products-grid">
          <% products.forEach(p => { %>
          <%- include('partials/product-card', { p }) %>
          <% }) %>
        </div>

        <!-- Pagination -->
        <% if (pagination.totalPages > 1) { %>
        <div class="pagination">
          <% if (pagination.page > 1) { %>
          <a href="/shop/<%= filters.category %>?<%= new URLSearchParams({...filters, page: pagination.page - 1}).toString() %>" class="pagination__btn">← <%= t.prev %></a>
          <% } %>
          <span class="pagination__info"><%= t.page %> <%= pagination.page %> <%= t.of %> <%= pagination.totalPages %></span>
          <% if (pagination.page < pagination.totalPages) { %>
          <a href="/shop/<%= filters.category %>?<%= new URLSearchParams({...filters, page: pagination.page + 1}).toString() %>" class="pagination__btn"><%= t.next_page %> →</a>
          <% } %>
        </div>
        <% } %>
        <% } %>
      </main>

    </div>
  </div>
</div>

<%- include('partials/footer') %>
