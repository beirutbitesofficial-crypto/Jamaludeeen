<%- include('partials/header', { title: t.checkout }) %>
<% const ar = lang === 'ar';
   const money = n => currency === 'USD' ? '$' + Number(n || 0).toFixed(2).replace(/\.00$/, '') : Math.round(n || 0).toLocaleString('en-US') + ' LBP'; %>

<main class="section section--page">
  <div class="container">
    <header class="page-title">
      <p class="eyebrow"><span></span><%= ar ? 'إتمام الطلب' : 'Secure checkout' %></p>
      <h1 class="display display--xl"><%= t.checkout %></h1>
      <p><%= ar ? 'كمّل معلوماتك، اختار طريقة الدفع، وبنجهّز طلبك مباشرة.' : 'Add your details, choose how to pay, and we will prepare your order.' %></p>
    </header>

    <div class="bag bag--checkout">
      <form class="checkout" action="/checkout" method="POST">
        <section class="checkout__step">
          <h2><span>01</span><%= t.customer_info %></h2>
          <div class="fields">
            <label class="field">
              <span><%= t.full_name %> *</span>
              <input type="text" name="name" required autocomplete="name" maxlength="120" placeholder="<%= ar ? 'الاسم الكامل' : 'Full name' %>"/>
            </label>
            <label class="field">
              <span><%= t.phone %> *</span>
              <input type="tel" name="phone" required autocomplete="tel" inputmode="tel" pattern="[0-9+\s\-()]{6,20}" maxlength="20" placeholder="+961 70 000 000" dir="ltr"/>
            </label>
            <label class="field field--full">
              <span><%= t.address %> *</span>
              <input type="text" name="address" required autocomplete="street-address" maxlength="250" placeholder="<%= ar ? 'الشارع، البناية، الطابق...' : 'Street, building, floor…' %>"/>
            </label>
            <label class="field field--full">
              <span><%= t.city %> *</span>
              <input type="text" name="city" required autocomplete="address-level2" maxlength="120" placeholder="<%= ar ? 'المدينة / المنطقة' : 'City / region' %>"/>
            </label>
            <label class="field field--full">
              <span><%= t.notes %></span>
              <textarea name="notes" rows="3" maxlength="1000" placeholder="<%= ar ? 'ملاحظات للتوصيل أو الطلب...' : 'Delivery or gifting notes…' %>"></textarea>
            </label>
          </div>
        </section>

        <section class="checkout__step">
          <h2><span>02</span><%= t.payment_method %></h2>
          <div class="pay">
            <label class="pay__opt">
              <input type="radio" name="payment_method" value="cod" required checked/>
              <span class="pay__box"><i></i><span><strong><%= t.cash_on_delivery %></strong><em><%= t.cod_desc %></em></span><b>COD</b></span>
            </label>
            <label class="pay__opt">
              <input type="radio" name="payment_method" value="whish"/>
              <span class="pay__box"><i></i><span><strong><%= t.bywhish_money %></strong><em><%= t.whish_desc %></em></span><b>WHISH</b></span>
            </label>
          </div>
        </section>

        <button type="submit" class="btn btn--gold btn--block btn--lg"><%= t.place_order %> · <%= money(total) %></button>
        <p class="checkout__hint"><%= ar ? 'بعد حفظ الطلب، رح يفتح واتساب برسالة الطلب كاملة وجاهزة للإرسال.' : 'Once your order is saved, WhatsApp opens with your complete order ready to send.' %></p>
      </form>

      <aside class="summary summary--sticky">
        <p class="eyebrow"><span></span><%= ar ? 'طلبك' : 'Your order' %></p>
        <ul class="mini-items">
          <% items.forEach(item => { %>
          <li>
            <span class="mini-items__media">
              <% if (item.image_path) { %><img src="<%= item.image_path %>" alt="" referrerpolicy="no-referrer" data-fallback=""/><% } else { %><span class="card__monogram">J</span><% } %>
              <i><%= item.qty %></i>
            </span>
            <span class="mini-items__info">
              <small><bdi><%= item.brand || 'Jamaludeen' %></bdi></small>
              <strong><%= ar && item.name_ar ? item.name_ar : item.name_en %></strong>
              <% if (item.size_ml) { %><small><%= item.size_ml %> ml</small><% } %>
            </span>
            <b><%= money(item.price * item.qty) %></b>
          </li>
          <% }) %>
        </ul>
        <dl class="summary__rows">
          <div><dt><%= t.subtotal %></dt><dd><%= money(subtotal) %></dd></div>
          <div><dt><%= t.delivery_fee %></dt><dd><%= deliveryFee > 0 ? money(deliveryFee) : t.free %></dd></div>
          <div class="summary__total"><dt><%= t.total %></dt><dd><%= money(total) %></dd></div>
        </dl>
        <div class="summary__trust"><span><%= ar ? 'طلبك محفوظ قبل فتح واتساب' : 'Saved before WhatsApp opens' %></span><span><%= ar ? 'تأكيد مباشر' : 'Direct confirmation' %></span></div>
      </aside>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
