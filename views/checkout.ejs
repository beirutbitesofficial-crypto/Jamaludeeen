        </div>

        <div class="store-order-card__rows store-order-card__rows--checkout">
          <div><span><%= t.subtotal %></span><strong><%= subtotal.toLocaleString() %> LBP</strong></div>
          <div><span><%= t.delivery_fee %></span><strong><%= deliveryFee > 0 ? deliveryFee.toLocaleString() + ' LBP' : t.free %></strong></div>
          <div class="store-order-card__total"><span><%= t.total %></span><strong><%= total.toLocaleString() %> LBP</strong></div>
