<%- include('partials/header', { title: t.checkout }) %>

<main class="store-checkout-page">
  <div class="container">
    <div class="store-page-heading store-page-heading--checkout">
      <p class="store-kicker store-kicker--dark">JAMALUDEEN CHECKOUT</p>
      <h1><%= t.checkout %></h1>
      <p><%= lang === 'ar' ? 'كمّل معلوماتك، اختار طريقة الدفع، وبنجهّز طلبك مباشرة.' : 'Add your details, choose a payment method and place your order.' %></p>
    </div>

    <div class="store-checkout-layout">
      <form class="store-checkout-form" action="/checkout" method="POST">
        <section class="store-checkout-section">
          <div class="store-checkout-section__head">
            <span>01</span>
            <div><h2><%= t.customer_info %></h2><p><%= lang === 'ar' ? 'معلومات التواصل والتوصيل' : 'Contact & delivery information' %></p></div>
          </div>

          <div class="store-form-grid">
            <label class="store-form-field">
              <span><%= t.full_name %> *</span>
              <input type="text" name="name" required autocomplete="name" placeholder="<%= lang === 'ar' ? 'الاسم الكامل' : 'Full name' %>"/>
            </label>
            <label class="store-form-field">
              <span><%= t.phone %> *</span>
              <input type="tel" name="phone" required autocomplete="tel" placeholder="+961 70 000 000"/>
            </label>
            <label class="store-form-field store-form-field--full">
              <span><%= t.address %> *</span>
              <input type="text" name="address" required autocomplete="street-address" placeholder="<%= lang === 'ar' ? 'الشارع، البناية، الطابق...' : 'Street, building, floor...' %>"/>
            </label>
            <label class="store-form-field store-form-field--full">
              <span><%= t.city %> *</span>
              <input type="text" name="city" required autocomplete="address-level2" placeholder="<%= lang === 'ar' ? 'المدينة / المنطقة' : 'City / region' %>"/>
            </label>
            <label class="store-form-field store-form-field--full">
              <span><%= t.notes %></span>
              <textarea name="notes" rows="4" placeholder="<%= lang === 'ar' ? 'ملاحظات للتوصيل أو الطلب...' : 'Delivery or order notes...' %>"></textarea>
            </label>
          </div>
        </section>

        <section class="store-checkout-section">
          <div class="store-checkout-section__head">
            <span>02</span>
            <div><h2><%= t.payment_method %></h2><p><%= lang === 'ar' ? 'اختار الطريقة الأنسب إلك' : 'Choose what works best for you' %></p></div>
          </div>

          <div class="store-payment-options">
            <label class="store-payment-option">
              <input type="radio" name="payment_method" value="cod" required checked/>
              <span class="store-payment-option__radio"></span>
              <div><strong><%= t.cash_on_delivery %></strong><p><%= t.cod_desc %></p></div>
              <b>COD</b>
            </label>
            <label class="store-payment-option">
              <input type="radio" name="payment_method" value="whish"/>
              <span class="store-payment-option__radio"></span>
              <div><strong><%= t.bywhish_money %></strong><p><%= t.whish_desc %></p></div>
              <b>WHISH</b>
            </label>
          </div>
        </section>

        <button type="submit" class="store-btn store-btn--dark store-btn--full store-btn--checkout"><%= t.place_order %></button>
        <p class="store-checkout-hint"><%= lang === 'ar' ? 'بعد حفظ الطلب، رح يفتح واتساب برسالة الطلب كاملة وجاهزة للإرسال.' : 'After the order is saved, WhatsApp will open with your complete order message ready to send.' %></p>
      </form>

      <aside class="store-checkout-summary">
        <div class="store-checkout-summary__head">
          <p class="store-kicker store-kicker--dark"><%= lang === 'ar' ? 'طلبك' : 'YOUR ORDER' %></p>
          <h2><%= t.order_summary %></h2>
        </div>

        <div class="store-checkout-summary__items">
          <% items.forEach(item => { %>
          <div class="store-checkout-item">
            <div class="store-checkout-item__image">
              <% if (item.image_path) { %><img src="<%= item.image_path %>" alt="<%= item.name_en %>"/><% } else { %><span>J</span><% } %>
              <i><%= item.qty %></i>
            </div>
            <div class="store-checkout-item__info">
              <small><%= item.brand %></small>
              <strong><%= lang === 'ar' && item.name_ar ? item.name_ar : item.name_en %><% if (item.size_ml) { %> · <%= item.size_ml %>ml<% } %></strong>
            </div>
            <b><%= item.type === 'local' ? '
          </div>
          <% }) %>
        </div>

        <div class="store-order-card__rows store-order-card__rows--checkout">
          <div><span><%= t.subtotal %></span><strong><%= currency === 'USD' ? '
        </div>

        <div class="store-checkout-summary__trust">
          <div><span>01</span><p><%= lang === 'ar' ? 'طلبك محفوظ بالنظام قبل فتح واتساب.' : 'Your order is saved before WhatsApp opens.' %></p></div>
          <div><span>02</span><p><%= lang === 'ar' ? 'تأكيد سريع ومباشر مع المتجر.' : 'Fast direct confirmation with the store.' %></p></div>
        </div>
      </aside>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
