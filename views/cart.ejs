<%- include('partials/header', { title: t.your_cart }) %>
<% const ar = lang === 'ar';
   const money = n => currency === 'USD' ? '$' + Number(n || 0).toFixed(2).replace(/\.00$/, '') : Math.round(n || 0).toLocaleString('en-US') + ' LBP';
   const itemCount = items.reduce((s, i) => s + i.qty, 0); %>

<main class="section section--page">
  <div class="container">
    <header class="page-title">
      <p class="eyebrow"><span></span>Jamaludeen</p>
      <h1 class="display display--xl"><%= ar ? 'حقيبتك' : 'Your bag' %></h1>
      <% if (items.length) { %><p><%= itemCount %> <%= ar ? 'قطعة' : (itemCount === 1 ? 'piece' : 'pieces') %></p><% } %>
    </header>

    <% if (!items.length) { %>
      <div class="empty empty--large">
        <span class="empty__mark">J</span>
        <h2><%= t.cart_empty %></h2>
        <p><%= t.cart_empty_sub %></p>
        <a href="/shop/men" class="btn btn--dark"><%= t.continue_shopping %></a>
      </div>
    <% } else { %>
      <div class="bag">
        <section class="bag__items">
          <% items.forEach(item => { %>
          <article class="bag-item">
            <a href="/shop/item/<%= item.id %>" class="bag-item__media">
              <% if (item.image_path) { %><img src="<%= item.image_path %>" alt="<%= item.name_en %>" referrerpolicy="no-referrer" data-fallback=""/><% } else { %><span class="card__monogram">J</span><% } %>
            </a>
            <div class="bag-item__info">
              <p class="card__house"><bdi><%= item.brand || 'Jamaludeen' %></bdi></p>
              <a href="/shop/item/<%= item.id %>" class="bag-item__name"><%= ar && item.name_ar ? item.name_ar : item.name_en %></a>
              <p class="bag-item__meta"><% if (item.size_ml) { %><%= item.size_ml %> ml · <% } %><%= money(item.price) %></p>
              <div class="bag-item__actions">
                <form action="/cart/update" method="POST" class="stepper stepper--sm">
                  <input type="hidden" name="productId" value="<%= item.id %>"/>
                  <% if (item.size_ml) { %><input type="hidden" name="size_ml" value="<%= item.size_ml %>"/><% } %>
                  <button type="submit" name="qty" value="<%= item.qty - 1 %>" aria-label="-">−</button>
                  <span><%= item.qty %></span>
                  <button type="submit" name="qty" value="<%= Math.min(99, item.qty + 1) %>" aria-label="+">+</button>
                </form>
                <form action="/cart/remove" method="POST">
                  <input type="hidden" name="productId" value="<%= item.id %>"/>
                  <% if (item.size_ml) { %><input type="hidden" name="size_ml" value="<%= item.size_ml %>"/><% } %>
                  <button type="submit" class="text-btn"><%= t.remove %></button>
                </form>
              </div>
            </div>
            <div class="bag-item__total"><%= money(item.price * item.qty) %></div>
          </article>
          <% }) %>

          <div class="bag__foot">
            <a href="/shop/men" class="link-arrow link-arrow--back"><%= t.continue_shopping %></a>
            <form action="/cart/clear" method="POST"><button type="submit" class="text-btn"><%= ar ? 'إفراغ الحقيبة' : 'Clear bag' %></button></form>
          </div>
        </section>

        <aside class="summary">
          <p class="eyebrow"><span></span><%= t.order_summary %></p>
          <dl class="summary__rows">
            <div><dt><%= t.subtotal %></dt><dd><%= money(subtotal) %></dd></div>
            <div><dt><%= t.delivery_fee %></dt><dd><%= deliveryFee > 0 ? money(deliveryFee) : t.free %></dd></div>
            <div class="summary__total"><dt><%= t.total %></dt><dd><%= money(total) %></dd></div>
          </dl>
          <% if (currency === 'LBP' && items.some(i => i.type === 'local')) { %>
          <p class="summary__note"><%= ar ? 'أسعار العطور المعبّأة محوّلة إلى الليرة على سعر ' : 'Signature refills converted to LBP at ' %><%= Math.round(rate).toLocaleString('en-US') %> LBP/$.</p>
          <% } %>
          <a href="/checkout" class="btn btn--dark btn--block"><%= t.proceed_to_checkout %></a>
          <p class="summary__note"><%= ar ? 'التوصيل النهائي وطريقة الدفع بيتأكدوا عند إتمام الطلب.' : 'Delivery details and payment method are confirmed at checkout.' %></p>
          <div class="summary__trust"><span><%= t.cash_on_delivery %></span><span>Whish Money</span></div>
        </aside>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
