<%- include('partials/header', { title: 'Home', bodyClass: 'is-home' }) %>
<% const ar = lang === 'ar'; const heroImage = settings.banner_image || '/images/covers/hero.webp'; %>

<main>
  <section class="hero">
    <div class="hero__glow"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--light"><span></span><%= ar ? 'دار عطور · لبنان' : 'Maison de Parfum · Lebanon' %></p>
        <h1 class="hero__title">
          <% if (ar) { %>عطرٌ <em>يروي</em><br/>حكايتك<% } else { %>A fragrance<br/>that tells <em>your</em><br/>story.<% } %>
        </h1>
        <p class="hero__lede"><%= ar ? 'تشكيلة مختارة بعناية من العطور الرجالية والنسائية واليونيسكس، من أرقى الدور العالمية والعربية — تُحضَّر بعناية وتُسلَّم لكل لبنان.' : 'A considered edit of men’s, women’s and unisex fragrances from the finest international and Arabic houses — prepared with care, delivered across Lebanon.' %></p>
        <div class="hero__actions">
          <a href="/shop/men" class="btn btn--gold"><%= ar ? 'اكتشف المجموعة' : 'Discover the collection' %></a>
          <a href="/collections" class="btn btn--line-light"><%= ar ? 'الماركات' : 'The houses' %></a>
        </div>
      </div>
      <div class="hero__visual">
        <div class="hero__frame">
          <img src="<%= heroImage %>" alt="" fetchpriority="high"/>
        </div>
        <div class="hero__badge">
          <span>50 · 100 ml</span>
          <strong><%= ar ? 'من' : 'From' %> $<%= refillUsd[50] %></strong>
          <em><%= ar ? 'توقيع جمال الدين' : 'Signature refills' %></em>
        </div>
      </div>
    </div>
    <div class="container hero__meta">
      <div><b>I</b><span><%= ar ? 'توصيل لجميع المناطق' : 'Nationwide delivery' %></span></div>
      <div><b>II</b><span><%= ar ? 'دفع عند الاستلام' : 'Cash on delivery' %></span></div>
      <div><b>III</b><span><%= ar ? 'طلب سريع عبر واتساب' : 'Personal WhatsApp service' %></span></div>
    </div>
  </section>

  <% if (brands.length) { %>
  <section class="marquee" aria-label="<%= t.brands %>">
    <div class="marquee__track">
      <% for (let r = 0; r < 2; r++) { %>
      <div class="marquee__group" <% if (r) { %>aria-hidden="true"<% } %>>
        <% brands.forEach(b => { %><a href="/collections/<%= b.id %>" <% if (r) { %>tabindex="-1"<% } %>><%= b.name %></a><i>✦</i><% }) %>
      </div>
      <% } %>
    </div>
  </section>
  <% } %>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow"><span></span><%= ar ? 'تسوّق حسب الفئة' : 'The Collections' %></p>
          <h2 class="display"><%= ar ? 'اختار العطر اللي بيشبهك' : 'Find the scent that feels like you.' %></h2>
        </div>
        <a href="/collections" class="link-arrow"><%= ar ? 'كل الماركات' : 'Explore all houses' %></a>
      </div>

      <div class="cats">
        <% [
          { key: 'men', title: t.men_perfumes, count: stats.men, img: covers.men, pos: 'center 40%', num: 'I' },
          { key: 'women', title: t.women_perfumes, count: stats.women, img: covers.women, pos: 'center 35%', num: 'II' },
          { key: 'unisex', title: t.unisex_perfumes, count: stats.unisex, img: covers.unisex, pos: '70% center', num: 'III' },
        ].forEach(c => { %>
        <a href="/shop/<%= c.key %>" class="cat reveal cat--<%= c.key %>">
          <div class="cat__media" <% if (c.img) { %>style="background-image:url('<%= c.img %>');background-position:<%= c.pos %>"<% } %>></div>
          <div class="cat__veil"></div>
          <span class="cat__num"><%= c.num %></span>
          <div class="cat__body">
            <span class="cat__count"><%= c.count %> <%= t.products %></span>
            <h3><%= c.title %></h3>
            <span class="cat__cta"><%= t.shop_now %></span>
          </div>
        </a>
        <% }) %>
      </div>
    </div>
  </section>

  <% if (featured && featured.length) { %>
  <section class="section section--ivory">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow"><span></span><%= ar ? 'مختارات جمال الدين' : 'The Jamaludeen Edit' %></p>
          <h2 class="display"><%= ar ? 'مختارات مميزة' : 'Signature fragrances' %></h2>
        </div>
        <a href="/shop/men" class="link-arrow"><%= t.view_all %></a>
      </div>
      <div class="grid-products">
        <% featured.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <section class="story">
    <div class="container story__grid">
      <div class="story__copy reveal">
        <p class="eyebrow eyebrow--light"><span></span><%= ar ? 'فن العطر' : 'The Art of Scent' %></p>
        <h2 class="display display--light"><%= ar ? 'كل شي بدّك ياه لتختار عطرك بثقة.' : 'Everything you need to choose with confidence.' %></h2>
        <p><%= ar ? 'تصفّح حسب الفئة أو الماركة، احفظ المفضلة، وأكمل طلبك بخطوات واضحة وسريعة — مع خدمة شخصية على واتساب لتساعدك تلاقي عطرك.' : 'Browse by collection or house, save your favourites and complete your order in a few calm steps — with personal WhatsApp service to help you find your signature.' %></p>
        <a href="/contact" class="btn btn--line-light"><%= ar ? 'زورونا في البوتيك' : 'Visit the boutique' %></a>
      </div>
      <div class="story__stats reveal">
        <div><strong><%= stats.brands %></strong><span><%= ar ? 'دار عطور' : 'Fragrance houses' %></span></div>
        <div><strong><%= stats.men + stats.women + stats.unisex %></strong><span><%= ar ? 'عطر توقيع' : 'Signature scents' %></span></div>
        <div><strong>$<%= refillUsd[50] %></strong><span><%= ar ? 'ابتداءً من، 50ml' : 'From, for 50 ml' %></span></div>
      </div>
    </div>
  </section>

  <% if (bestSellers && bestSellers.length) { %>
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow"><span></span><%= ar ? 'الأكثر طلباً' : 'Most Wanted' %></p>
          <h2 class="display"><%= ar ? 'الأكثر مبيعاً' : 'Best sellers' %></h2>
        </div>
        <a href="/shop/men" class="link-arrow"><%= t.view_all %></a>
      </div>
      <div class="grid-products">
        <% bestSellers.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (brands.length) { %>
  <section class="section section--ivory">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <div>
          <p class="eyebrow eyebrow--center"><span></span><%= ar ? 'تسوّق حسب الماركة' : 'The Houses' %><span></span></p>
          <h2 class="display"><%= ar ? 'ماركات عالمية وعربية' : 'International & Arabic houses' %></h2>
        </div>
      </div>
      <div class="houses reveal">
        <% brands.forEach(b => { %><a href="/collections/<%= b.id %>"><%= b.name %></a><% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <section class="promises">
    <div class="container promises__grid">
      <div class="reveal"><span class="promises__icon">✦</span><strong><%= ar ? 'توصيل لكل لبنان' : 'Delivery across Lebanon' %></strong><p><%= ar ? 'طلبك بيوصل لعندك بكل المناطق.' : 'Carefully packed and delivered wherever you are.' %></p></div>
      <div class="reveal"><span class="promises__icon">✦</span><strong><%= ar ? 'دفع مرن' : 'Flexible payment' %></strong><p><%= ar ? 'كاش عند الاستلام أو ويش موني.' : 'Cash on delivery or Whish Money.' %></p></div>
      <div class="reveal"><span class="promises__icon">✦</span><strong><%= ar ? 'خدمة شخصية' : 'Personal service' %></strong><p><%= ar ? 'تواصل معنا مباشرة عبر واتساب.' : 'Speak with us directly on WhatsApp.' %></p></div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
