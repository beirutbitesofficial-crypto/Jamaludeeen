<!DOCTYPE html>
<html lang="<%= a.lang %>" dir="<%= a.dir %>">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="robots" content="noindex"/>
  <meta name="theme-color" content="#0f0e0c"/>
  <title><%= title %> · JAMALUDEEN</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@400;500;600&family=Amiri:wght@400;700&family=Noto+Sans+Arabic:wght@400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/backoffice.css?v=20261001-2"/>
</head>
<body class="sys">
<%
  const isMgr = ['owner', 'manager'].includes(currentUser.role);
  const isOwner = currentUser.role === 'owner';
  const nav = [
    { label: a('overview'), items: [ ['dashboard', 'dashboard', a('dashboard')], ['pos', 'pos', a('pos')] ] },
    { label: a('store_system'), items: [
      isMgr && ['inventory', 'box', a('inventory')],
      ['sales', 'receipt', a('sales')],
      isMgr && ['online', 'globe', a('online_orders')],
      ['customers', 'users', a('customers')],
      isMgr && ['purchases', 'truck', a('purchases')],
      isMgr && ['expenses', 'wallet', a('expenses')],
      isMgr && ['reports', 'chart', a('reports')],
      isOwner && ['team', 'team', a('team')],
    ].filter(Boolean) },
  ];
  const sectionTabs = (id) => `<nav class="tabs tabs--pos" data-sections="${id}">` + ['men','women','unisex','brands'].map(k =>
    `<button type="button" data-section="${k}">${a(k)}<span class="tabs__count num">${counts[k]}</span></button>`).join('') + `</nav>
    <div class="chips chips--scroll" data-brands="${id}" hidden>
      <button type="button" class="chip is-active" data-brand="">${a('all_brands')}</button>` +
      brands.map(b => `<button type="button" class="chip" data-brand="${String(b.name).replace(/"/g, '&quot;')}">${b.name} <small class="num">${b.count}</small></button>`).join('') + `</div>`;
%>
<div class="bo">
  <aside class="bo-side" id="boSide">
    <div class="bo-brand">
      <span class="bo-brand__mark">J</span>
      <span><span class="bo-brand__name">JAMALUDEEN</span><br/><span class="bo-brand__sub"><%= a('store_system') %></span></span>
    </div>
    <nav class="bo-nav" id="nav">
      <% nav.forEach(g => { %>
      <div class="bo-nav-group">
        <div class="bo-nav-label"><%= g.label %></div>
        <% g.items.forEach(([tab, ic, text]) => { %><button type="button" data-tab="<%= tab %>"><%- icon(ic) %><span><%= text %></span></button><% }) %>
      </div>
      <% }) %>
    </nav>
    <div class="bo-side__foot bo-nav">
      <div class="bo-user">
        <span class="bo-user__avatar"><%= String(currentUser.name || '?').slice(0, 1) %></span>
        <span><span class="bo-user__name"><%= currentUser.name %></span><br/><span class="bo-user__role"><%= a('role_' + currentUser.role) %></span></span>
      </div>
      <% if (isOwner) { %><a href="/admin/dashboard"><%- icon('settings') %><span><%= a('website_admin') %></span></a><% } %>
      <a href="/" target="_blank" rel="noopener"><%- icon('store') %><span><%= a('view_store') %></span><%- icon('external', 'muted') %></a>
      <form action="/system/logout" method="POST"><button type="submit"><%- icon('logout', 'ico-flip') %><span><%= a('logout') %></span></button></form>
    </div>
  </aside>
  <div class="bo-scrim" id="boScrim"></div>

  <div class="bo-main">
    <header class="bo-top">
      <button class="bo-burger" id="boBurger" type="button" aria-label="<%= a('menu') %>"><%- icon('menu') %></button>
      <div class="bo-top__title" id="topTitle"><%= a('store_system') %></div>
      <div class="bo-top__actions">
        <span id="shiftBadge"></span>
        <span class="pill pill--plain num rate-pill" dir="ltr" title="<%= a('exchange_rate') %>">$1 = <span id="rateLabel"><%= Number(systemRate).toLocaleString('en-US') %></span></span>
        <form action="/set-lang" method="POST"><button class="btn btn--sm lang-btn" name="lang" value="<%= a.lang === 'ar' ? 'en' : 'ar' %>" type="submit"><%- icon('globe') %><%= a('language') %></button></form>
      </div>
    </header>

    <main class="bo-content">
      <!-- Dashboard -->
      <section class="sys-tab" id="tab-dashboard">
        <div class="bo-head">
          <div><p class="bo-kicker"><%= a('today_glance') %></p><h1><%= a('dashboard') %></h1></div>
          <div class="bo-head__actions">
            <button class="btn" id="refreshDashboard"><%- icon('refund') %><%= a('refresh') %></button>
            <button class="btn btn--dark" data-go="pos"><%- icon('pos') %><%= a('pos') %></button>
          </div>
        </div>
        <div class="grid grid--4" id="dashboardMetrics"></div>
        <div class="grid grid--2" style="margin-top:20px">
          <section class="card">
            <div class="card__head"><h2><%- icon('clock') %> <%= a('current_shift') %></h2><button class="btn btn--sm btn--dark" id="shiftActionBtn"><%= a('open_shift') %></button></div>
            <div class="card__body" id="shiftBox"></div>
          </section>
          <% if (isMgr) { %>
          <section class="card">
            <div class="card__head"><h2><%- icon('coin') %> <%= a('exchange_rate') %></h2></div>
            <form class="card__body form" id="exchangeForm">
              <span class="input-affix"><span dir="ltr">1 USD =</span><input type="number" name="exchange_rate" min="1" step="100" value="<%= systemRate %>" dir="ltr" required/><span>LBP</span></span>
              <small class="hint"><%= a('exchange_hint') %></small>
              <div><button class="btn btn--dark" type="submit"><%= a('save') %></button></div>
            </form>
          </section>
          <% } else { %>
          <section class="card"><div class="card__head"><h2><%= a('pos') %></h2></div><div class="card__body"><p class="muted"><%= a('register_hint') %></p></div></section>
          <% } %>
        </div>
        <section class="card" style="margin-top:20px">
          <div class="card__head"><h2><%= a('recent_sales') %></h2><button class="btn btn--sm btn--ghost" data-go="sales"><%= a('view_all') %></button></div>
          <div id="recentSales"></div>
        </section>
      </section>

      <!-- POS -->
      <section class="sys-tab" id="tab-pos">
        <div class="pos">
          <div class="pos__catalog">
            <div class="pos__search">
              <label class="search"><%- icon('search') %><input id="posSearch" type="search" placeholder="<%= a('scan_hint') %>" autocomplete="off"/></label>
            </div>
            <%- sectionTabs('pos') %>
            <div id="posProducts" class="pos-grid"></div>
            <div id="posMore" class="pos__more" hidden><button class="btn" type="button"><%= a('next') %></button></div>
          </div>

          <aside class="pos__cart card" id="cartPanel">
            <div class="card__head">
              <h2><%- icon('cart') %> <%= a('current_sale') %> <span class="pill pill--dark num" id="cartCount">0</span></h2>
              <button class="btn btn--sm btn--ghost btn--danger" id="clearCart"><%- icon('trash') %></button>
              <button class="btn btn--sm btn--ghost pos__cart-close" id="cartClose" type="button"><%- icon('x') %></button>
            </div>
            <div class="cart-lines" id="cartItems"></div>
            <div class="card__body form cart-form">
              <div class="field--row">
                <label class="field"><span><%= a('customer_name') %></span><input id="customerName" autocomplete="off"/></label>
                <label class="field"><span><%= a('phone') %></span><input id="customerPhone" inputmode="tel" dir="ltr" autocomplete="off"/></label>
              </div>
              <% if (isMgr) { %>
              <label class="field"><span><%= a('discount_lbp') %></span><input id="saleDiscount" type="number" min="0" step="1000" value="0" dir="ltr"/></label>
              <% } else { %><input id="saleDiscount" type="hidden" value="0"/><% } %>
              <div class="field"><span><%= a('payment') %></span>
                <div class="seg" id="paymentMethod">
                  <button type="button" data-pay="cash_lbp" class="is-active"><%= a('cash_lbp') %></button>
                  <button type="button" data-pay="cash_usd"><%= a('cash_usd') %></button>
                  <button type="button" data-pay="whish"><%= a('whish') %></button>
                  <button type="button" data-pay="card"><%= a('card') %></button>
                </div>
              </div>
              <label class="field" id="tenderedLbpWrap"><span><%= a('tendered_lbp') %></span><input id="tenderedLbp" type="number" min="0" step="1000" placeholder="0" dir="ltr"/></label>
              <label class="field" id="tenderedUsdWrap" hidden><span><%= a('tendered_usd') %></span><input id="tenderedUsd" type="number" min="0" step="0.01" placeholder="0" dir="ltr"/></label>
              <label class="field"><span><%= a('sale_note') %> <small>(<%= a('optional') %>)</small></span><input id="saleNotes"/></label>
            </div>
            <div class="cart-total" id="cartTotals"></div>
            <div class="cart-pay"><button id="completeSale" class="btn btn--gold btn--lg btn--block"><%- icon('check') %><%= a('complete_sale') %></button></div>
          </aside>
        </div>
        <button class="pos-bar" id="cartBar" type="button"><span><%- icon('cart') %> <b class="num" id="cartBarCount">0</b></span><strong class="num" id="cartBarTotal" dir="ltr">0 LBP</strong><span><%= a('current_sale') %> <%- icon('arrow', 'ico-flip') %></span></button>
      </section>

      <% if (isMgr) { %>
      <!-- Inventory -->
      <section class="sys-tab" id="tab-inventory">
        <div class="bo-head"><div><p class="bo-kicker"><%= a('store_system') %></p><h1><%= a('inventory') %></h1><p><%= a('inventory_intro') %></p></div></div>
        <%- sectionTabs('inv') %>
        <div class="toolbar">
          <label class="search toolbar__grow"><%- icon('search') %><input id="inventorySearch" type="search" placeholder="<%= a('search_products') %>"/></label>
          <label class="switch switch--inline"><input id="lowStockOnly" type="checkbox"/><span class="switch__ui"></span><span><%= a('low_stock_only') %></span></label>
        </div>
        <section class="card"><div class="table-wrap"><table class="table">
          <thead><tr><th><%= a('product') %></th><th><%= a('price') %></th><th><%= a('cost') %></th><th><%= a('stock') %></th><th><%= a('sku') %> / <%= a('barcode') %></th><th></th></tr></thead>
          <tbody id="inventoryRows"></tbody></table></div>
          <div class="pager" id="invPager" hidden></div>
        </section>
      </section>
      <% } %>

      <!-- Sales -->
      <section class="sys-tab" id="tab-sales">
        <div class="bo-head"><div><p class="bo-kicker"><%= a('store_system') %></p><h1><%= a('sales') %></h1></div></div>
        <div class="toolbar">
          <label class="field field--inline"><span><%= a('from') %></span><input type="date" id="salesFrom"/></label>
          <label class="field field--inline"><span><%= a('to') %></span><input type="date" id="salesTo"/></label>
          <button class="btn btn--dark" id="salesFilterBtn"><%= a('load') %></button>
        </div>
        <section class="card"><div class="table-wrap"><table class="table">
          <thead><tr><th><%= a('sale') %></th><th><%= a('date') %></th><th><%= a('customer') %></th><th><%= a('cashier') %></th><th><%= a('payment') %></th><th><%= a('total') %></th><th><%= a('status') %></th><th></th></tr></thead>
          <tbody id="salesRows"></tbody></table></div></section>
      </section>

<% if (isMgr) { %>
      <!-- Online orders -->
      <section class="sys-tab" id="tab-online">
        <div class="bo-head"><div><p class="bo-kicker"><%= a('store_system') %></p><h1><%= a('online_orders') %></h1><p><%= a('online_intro') %></p></div>
          <div class="bo-head__actions"><a class="btn" href="/admin/orders"><%- icon('external') %><%= a('website_admin') %></a></div></div>
        <div class="grid grid--3" id="onlineStats"></div>
        <nav class="tabs" id="onlineTabs" style="margin-top:20px">
          <button type="button" data-ostatus="" class="is-active"><%= a('st_all') %><span class="tabs__count num" data-ocount="all"></span></button>
          <% ['pending','confirmed','shipped','delivered','cancelled'].forEach(st => { %><button type="button" data-ostatus="<%= st %>"><%= a('st_' + st) %><span class="tabs__count num" data-ocount="<%= st %>"></span></button><% }) %>
        </nav>
        <div class="toolbar"><label class="search toolbar__grow"><%- icon('search') %><input id="onlineSearch" type="search" placeholder="# / <%= a('customer') %> / <%= a('phone') %>"/></label></div>
        <section class="card"><div class="table-wrap"><table class="table">
          <thead><tr><th>#</th><th><%= a('date') %></th><th><%= a('customer') %></th><th><%= a('city') %></th><th><%= a('payment') %></th><th><%= a('total') %></th><th><%= a('status') %></th><th></th></tr></thead>
          <tbody id="onlineRows"></tbody></table></div></section>
      </section>
<% } %>

      <!-- Customers -->
      <section class="sys-tab" id="tab-customers">
        <div class="bo-head"><div><p class="bo-kicker"><%= a('store_system') %></p><h1><%= a('customers') %></h1></div></div>
        <div class="grid grid--side" style="grid-template-columns:minmax(0,1fr) 340px">
          <section class="card">
            <div class="toolbar" style="margin:0;padding:14px 16px;border:0;border-bottom:1px solid var(--line);border-radius:0"><label class="search toolbar__grow"><%- icon('search') %><input id="customerSearch" type="search" placeholder="<%= a('search') %>…"/></label></div>
            <div class="table-wrap"><table class="table"><thead><tr><th><%= a('name') %></th><th><%= a('phone') %></th><th><%= a('visits') %></th><th><%= a('spent') %></th></tr></thead><tbody id="customerRows"></tbody></table></div>
          </section>
          <form class="card" id="customerForm" style="align-self:start">
            <div class="card__head"><h2><%= a('add_customer') %></h2></div>
            <div class="card__body form">
              <label class="field"><span><%= a('name') %></span><input name="name" required/></label>
              <label class="field"><span><%= a('phone') %></span><input name="phone" dir="ltr"/></label>
              <label class="field"><span><%= a('email') %></span><input name="email" type="email" dir="ltr"/></label>
              <label class="field"><span><%= a('notes') %></span><textarea name="notes" rows="2"></textarea></label>
              <button class="btn btn--dark btn--block"><%- icon('plus') %><%= a('add_customer') %></button>
            </div>
          </form>
        </div>
      </section>

      <% if (isMgr) { %>
      <!-- Purchases -->
      <section class="sys-tab" id="tab-purchases">
        <div class="bo-head"><div><p class="bo-kicker"><%= a('store_system') %></p><h1><%= a('purchases') %></h1><p><%= a('purchases_intro') %></p></div></div>
        <div class="note" style="margin-bottom:18px"><%- icon('alert') %><span><%= a('purchases_hint') %></span></div>
        <div class="grid grid--side" style="grid-template-columns:minmax(0,1fr) 340px">
          <section class="card">
            <div class="card__head"><h2><%- icon('truck') %> <%= a('receive_stock') %></h2></div>
            <div class="card__body form">
              <div class="field--row">
                <label class="field"><span><%= a('supplier') %></span><select id="purchaseSupplier"></select></label>
                <label class="field"><span><%= a('invoice_no') %></span><input id="purchaseInvoice" dir="ltr"/></label>
              </div>
              <label class="search"><%- icon('search') %><input id="purchaseProductSearch" type="search" placeholder="<%= a('search_products') %>"/></label>
              <div id="purchaseProductResults" class="mini-results" hidden></div>
              <div id="purchaseItems"></div>
              <button id="savePurchase" class="btn btn--dark btn--lg btn--block"><%- icon('check') %><%= a('save_purchase') %></button>
            </div>
          </section>
          <section class="card" style="align-self:start">
            <div class="card__head"><h2><%= a('suppliers') %></h2></div>
            <form class="card__body form" id="supplierForm">
              <label class="field"><span><%= a('name') %></span><input name="name" required/></label>
              <label class="field"><span><%= a('phone') %></span><input name="phone" dir="ltr"/></label>
              <label class="field"><span><%= a('notes') %></span><input name="notes"/></label>
              <button class="btn btn--block"><%- icon('plus') %><%= a('add_supplier') %></button>
            </form>
            <div id="supplierList"></div>
          </section>
        </div>
        <section class="card" style="margin-top:20px"><div class="card__head"><h2><%= a('recent_purchases') %></h2></div><div id="purchaseHistory"></div></section>
      </section>

      <!-- Expenses -->
      <section class="sys-tab" id="tab-expenses">
        <div class="bo-head"><div><p class="bo-kicker"><%= a('store_system') %></p><h1><%= a('expenses') %></h1><p><%= a('expenses_intro') %></p></div></div>
        <div class="grid grid--side" style="grid-template-columns:minmax(0,1fr) 340px">
          <section class="card"><div id="expenseList"></div></section>
          <form class="card" id="expenseForm" style="align-self:start">
            <div class="card__head"><h2><%= a('add_expense') %></h2></div>
            <div class="card__body form">
              <label class="field"><span><%= a('category') %></span><select name="category">
                <% [['Rent','exp_rent'],['Salary','exp_salary'],['Delivery','exp_delivery'],['Marketing','exp_marketing'],['Utilities','exp_utilities'],['Supplies','exp_supplies'],['Other','exp_other']].forEach(([v,k]) => { %><option value="<%= v %>"><%= a(k) %></option><% }) %>
              </select></label>
              <label class="field"><span><%= a('description') %></span><input name="description" required/></label>
              <div class="field--row">
                <label class="field"><span>LBP</span><input name="amount_lbp" type="number" min="0" step="1000" value="0" dir="ltr"/></label>
                <label class="field"><span>USD</span><input name="amount_usd" type="number" min="0" step="0.01" value="0" dir="ltr"/></label>
              </div>
              <label class="switch switch--inline"><input name="from_drawer" type="checkbox" checked/><span class="switch__ui"></span><span><%= a('paid_from_drawer') %></span></label>
              <button class="btn btn--dark btn--block"><%= a('save_expense') %></button>
            </div>
          </form>
        </div>
      </section>

      <!-- Reports -->
      <section class="sys-tab" id="tab-reports">
        <div class="bo-head"><div><p class="bo-kicker"><%= a('store_system') %></p><h1><%= a('reports') %></h1><p><%= a('reports_intro') %></p></div></div>
        <div class="toolbar">
          <label class="field field--inline"><span><%= a('from') %></span><input type="date" id="reportFrom"/></label>
          <label class="field field--inline"><span><%= a('to') %></span><input type="date" id="reportTo"/></label>
          <button class="btn btn--dark" id="reportBtn"><%= a('generate') %></button>
        </div>
        <div class="grid grid--4 grid--5" id="reportMetrics"></div>
        <section class="card" style="margin-top:20px">
          <div class="card__head"><h2><%- icon('chart') %> <%= a('channels') %></h2><small class="hint"><%= a('delivered_note') %></small></div>
          <div class="card__body" id="channelReport"></div>
        </section>
        <div class="grid grid--2" style="margin-top:20px">
          <section class="card"><div class="card__head"><h2><%= a('best_sellers') %></h2></div><div id="topProducts"></div></section>
          <section class="card"><div class="card__head"><h2><%= a('payments') %></h2></div><div id="paymentReport"></div></section>
        </div>
      </section>
      <% } %>

      <% if (isOwner) { %>
      <!-- Team -->
      <section class="sys-tab" id="tab-team">
        <div class="bo-head"><div><p class="bo-kicker"><%= a('store_system') %></p><h1><%= a('team') %></h1><p><%= a('team_intro') %></p></div></div>
        <div class="grid grid--side" style="grid-template-columns:minmax(0,1fr) 340px">
          <section class="card"><div class="card__head"><h2><%= a('users') %></h2></div><div id="userList"></div></section>
          <form class="card" id="userForm" style="align-self:start">
            <div class="card__head"><h2><%= a('add_user') %></h2></div>
            <div class="card__body form">
              <label class="field"><span><%= a('full_name') %></span><input name="full_name" required/></label>
              <label class="field"><span><%= a('username') %></span><input name="username" required dir="ltr" autocomplete="off"/></label>
              <label class="field"><span><%= a('password') %></span><input name="password" type="password" required minlength="8" autocomplete="new-password"/><small><%= a('pw_short') %></small></label>
              <label class="field"><span><%= a('role') %></span><select name="role"><option value="cashier"><%= a('role_cashier') %></option><option value="manager"><%= a('role_manager') %></option></select></label>
              <button class="btn btn--dark btn--block"><%- icon('plus') %><%= a('create_user') %></button>
            </div>
          </form>
        </div>
      </section>
      <% } %>
    </main>
  </div>
</div>

<% if (isMgr) { %>
<div class="modal" id="inventoryModal">
  <div class="modal__box">
    <div class="modal__head"><h3 id="inventoryProductName"><%= a('edit_inventory') %></h3><button class="modal__close" data-close><%- icon('x') %></button></div>
    <div class="modal__body">
      <form id="inventoryForm" class="form">
        <input type="hidden" name="id"/>
        <p class="hint" id="inventoryUnitHint"></p>
        <div class="note" id="invRefillNote" hidden><%- icon('coin') %><span></span></div>
        <div class="field--row" data-brand-only>
          <label class="field"><span><%= a('base_price_lbp') %></span><input name="price" type="number" min="0" step="1000" dir="ltr"/></label>
        </div>
        <div class="field--row">
          <label class="field"><span><%= a('unit_cost') %></span><input name="cost_price" type="number" min="0" step="0.01" dir="ltr"/></label>
        </div>
        <div class="field--row" data-local-only>
          <label class="field"><span><%= a('cost_50') %></span><input name="cost_50ml" type="number" min="0" dir="ltr"/></label>
          <label class="field"><span><%= a('cost_100') %></span><input name="cost_100ml" type="number" min="0" dir="ltr"/></label>
        </div>
        <div class="field--row">
          <label class="field"><span><%= a('stock_qty') %></span><input name="stock_qty" type="number" step="0.01" dir="ltr"/></label>
          <label class="field"><span><%= a('low_alert') %></span><input name="low_stock_threshold" type="number" min="0" step="0.01" dir="ltr"/></label>
        </div>
        <div class="field--row">
          <label class="field"><span><%= a('sku') %></span><input name="sku" dir="ltr"/></label>
          <label class="field"><span><%= a('barcode') %></span><input name="barcode" dir="ltr"/></label>
        </div>
        <label class="switch switch--inline"><input name="track_stock" type="checkbox"/><span class="switch__ui"></span><span><%= a('track_stock') %></span></label>
        <label class="switch switch--inline"><input name="in_stock" type="checkbox"/><span class="switch__ui"></span><span><%= a('available_for_sale') %></span></label>
        <button class="btn btn--dark btn--block"><%= a('save_changes') %></button>
      </form>
      <form id="adjustForm" class="form adjust-form">
        <input type="hidden" name="id"/>
        <h4><%= a('quick_adjust') %></h4>
        <div class="field--row">
          <label class="field"><span><%= a('adjust_qty') %></span><input name="quantity" type="number" step="0.01" required dir="ltr"/></label>
          <label class="field"><span><%= a('reason') %></span><input name="note"/></label>
        </div>
        <button class="btn btn--block"><%= a('apply_adjust') %></button>
      </form>
    </div>
  </div>
</div>
<% } %>

<div class="modal" id="sizeModal">
  <div class="modal__box">
    <div class="modal__head"><h3 id="sizeProductName"><%= a('choose_size') %></h3><button class="modal__close" data-close><%- icon('x') %></button></div>
    <div class="modal__body">
      <p class="hint"><%= a('sizes_hint') %></p>
      <div class="size-pick">
        <button type="button" data-size="50"><strong>50 ml</strong><span id="size50Price" dir="ltr"></span></button>
        <button type="button" data-size="100"><strong>100 ml</strong><span id="size100Price" dir="ltr"></span></button>
      </div>
    </div>
  </div>
</div>
<div class="modal" id="orderModal"><div class="modal__box modal__box--wide"><div class="modal__head"><h3 id="orderTitle"></h3><button class="modal__close" data-close><%- icon('x') %></button></div><div class="modal__body" id="orderDetail"></div></div></div>
<div class="modal" id="saleModal"><div class="modal__box modal__box--wide"><div class="modal__head"><h3 id="saleTitle"></h3><button class="modal__close" data-close><%- icon('x') %></button></div><div class="modal__body" id="saleDetail"></div></div></div>
<div class="modal" id="shiftModal"><div class="modal__box"><div class="modal__head"><h3 id="shiftTitle"></h3><button class="modal__close" data-close><%- icon('x') %></button></div><div class="modal__body" id="shiftModalContent"></div></div></div>
<div class="toast" id="toast"></div>

<script>window.SYS = <%- JSON.stringify({
  user: currentUser,
  rate: Number(systemRate),
  refill: refillUsd,
  lang: a.lang,
  T: dict,
}).replace(/</g, '\\u003c') %>;</script>
<script src="/js/system.js?v=20261001-2"></script>
</body>
</html>
