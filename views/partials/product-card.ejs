<% const pName = lang === 'ar' && p.name_ar ? p.name_ar : p.name_en; %>
<article class="card reveal">
  <div class="card__media-wrap">
    <a href="/shop/item/<%= p.id %>" class="card__media<%= p.type === 'brand' && p.image_path && !p.image_path.includes('/brands/jamaludeen/') ? ' card__media--contain' : '' %>" aria-label="<%= p.name_en %>">
      <% if (p.image_path) { %>
        <img src="<%= thumb(p.image_path) %>" alt="<%= p.name_en %>" width="560" height="560" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-fallback="<%= p.brand || 'Jamaludeen' %>"/>
      <% } else { %>
        <div class="card__placeholder">
          <span class="card__monogram">J</span>
          <span class="card__ph-name"><%= p.name_en %></span>
          <span class="card__ph-house"><%= p.brand || 'Jamaludeen' %></span>
        </div>
      <% } %>
      <% if (!p.in_stock) { %><span class="card__tag"><%= t.out_of_stock %></span>
      <% } else if (p.type === 'local') { %><span class="card__tag card__tag--gold"><%= lang === 'ar' ? 'توقيع جمال الدين' : 'Signature' %></span><% } %>
    </a>
    <button class="wish-btn card__wish btn-wishlist" type="button" data-id="<%= p.id %>" aria-label="<%= lang === 'ar' ? 'المفضلة' : 'Save to wishlist' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </button>
    <% if (p.in_stock && p.price && p.type !== 'local') { %>
      <form action="/cart/add" method="POST" class="card__quick">
        <input type="hidden" name="productId" value="<%= p.id %>"/>
        <input type="hidden" name="qty" value="1"/>
        <button type="submit"><%= lang === 'ar' ? 'أضف إلى السلة' : 'Add to bag' %></button>
      </form>
    <% } else if (p.in_stock && p.type === 'local') { %>
      <a href="/shop/item/<%= p.id %>" class="card__quick"><span><%= lang === 'ar' ? 'اختر الحجم' : 'Choose size' %></span></a>
    <% } %>
  </div>

  <div class="card__body">
    <p class="card__house"><bdi><%= p.brand || 'Jamaludeen' %></bdi></p>
    <a href="/shop/item/<%= p.id %>" class="card__name"><%= pName %></a>
    <p class="card__price">
      <% if (p.type === 'local' && p.price_50ml) { %>
        <span><%= lang === 'ar' ? 'من' : 'From' %> <bdi>$<%= p.price_50ml %></bdi></span><em dir="ltr">50 · 100 ml</em>
      <% } else if (p.price) { %>
        <span class="price-display" data-lbp="<%= p.price %>"><%= p.price.toLocaleString('en-US') %> LBP</span>
      <% } else { %>
        <span class="is-muted"><%= t.price_not_set %></span>
      <% } %>
    </p>
  </div>
</article>
