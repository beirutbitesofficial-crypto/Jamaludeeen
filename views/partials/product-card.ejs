<article class="product-card store-product-card">
  <div class="store-product-card__media-wrap">
    <a href="/shop/item/<%= p.id %>" class="store-product-card__media" aria-label="<%= p.name_en %>">
      <% if (p.image_path) { %>
        <img src="<%= p.image_path %>" alt="<%= p.name_en %>" loading="lazy"/>
      <% } else { %>
        <div class="store-product-card__placeholder"><span>J</span></div>
      <% } %>
      <% if (!p.in_stock) { %>
        <span class="store-product-card__badge"><%= t.out_of_stock %></span>
      <% } %>
      <span class="store-product-card__view"><%= lang === 'ar' ? 'عرض التفاصيل' : 'View details' %></span>
    </a>

    <button class="btn-wishlist store-product-card__wishlist" data-id="<%= p.id %>" title="Save to Wishlist" aria-label="Wishlist">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
    </button>
  </div>

  <div class="store-product-card__body">
    <p class="store-product-card__brand"><%= p.brand || 'JAMALUDEEN' %></p>
    <a href="/shop/item/<%= p.id %>" class="store-product-card__name"><%= lang === 'ar' && p.name_ar ? p.name_ar : p.name_en %></a>

    <div class="store-product-card__buy-row">
      <% if (p.price) { %>
        <span class="store-product-card__price price-display" data-lbp="<%= p.price %>"><%= p.price.toLocaleString() %> LBP</span>
      <% } else { %>
        <span class="store-product-card__price store-product-card__price--muted"><%= t.price_not_set %></span>
      <% } %>
    </div>

    <% if (p.in_stock && p.price) { %>
      <form action="/cart/add" method="POST" class="store-product-card__form">
        <input type="hidden" name="productId" value="<%= p.id %>"/>
        <input type="hidden" name="qty" value="1"/>
        <button type="submit" class="store-product-card__add"><%= lang === 'ar' ? 'أضف إلى السلة' : 'Add to bag' %></button>
      </form>
    <% } else { %>
      <a href="/shop/item/<%= p.id %>" class="store-product-card__add store-product-card__add--secondary"><%= lang === 'ar' ? 'عرض المنتج' : 'View product' %></a>
    <% } %>
  </div>
</article>
