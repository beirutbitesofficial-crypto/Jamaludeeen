<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="theme-color" content="#0e0d0b"/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <meta name="description" content="Jamaludeen — maison de parfum in Lebanon. Signature refills, international houses and Arabic ouds, delivered across Lebanon."/>
  <title><%= title %> | JAMALUDEEN</title>
  <script>document.documentElement.classList.add('js');</script>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Jost:wght@300;400;500;600&family=Amiri:ital,wght@0,400;0,700;1,400&family=Noto+Sans+Arabic:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/luxe.css?v=20261001-1" type="text/css"/>
  <% if (typeof bodyClass !== 'undefined' && bodyClass === 'is-home') { %><link rel="stylesheet" href="/css/cinema.css?v=20261004-2" type="text/css"/>
  <link rel="preload" as="image" href="/images/hero/men-body.webp" fetchpriority="high"/><% } %>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">

<% if ((success_msg && success_msg.length) || (error_msg && error_msg.length)) { %>
<div class="toasts" role="status" aria-live="polite">
  <% if (success_msg && success_msg.length) { %>
  <div class="toast toast--success"><span class="toast__mark">✦</span><span><%= success_msg[0] %></span><button class="toast__close" type="button" aria-label="Close">✕</button></div>
  <% } %>
  <% if (error_msg && error_msg.length) { %>
  <div class="toast toast--error"><span class="toast__mark">!</span><span><%= error_msg[0] %></span><button class="toast__close" type="button" aria-label="Close">✕</button></div>
  <% } %>
</div>
<% } %>

<div class="announce">
  <div class="announce__track">
    <% for (let r = 0; r < 2; r++) { %>
    <div class="announce__group" <% if (r) { %>aria-hidden="true"<% } %>>
      <span><%= lang === 'ar' ? 'توصيل لكل لبنان' : 'Complimentary care · Delivery across Lebanon' %></span><i>✦</i>
      <span><%= lang === 'ar' ? 'دفع عند الاستلام أو ويش موني' : 'Cash on delivery or Whish Money' %></span><i>✦</i>
      <span><%= lang === 'ar' ? 'بوتيك جمال الدين · JMR Mall، مزبود' : 'Boutique · JMR Mall, Mazboud' %></span><i>✦</i>
      <span><%= lang === 'ar' ? 'عطر يروي حكايتك' : 'Find your signature scent' %></span><i>✦</i>
    </div>
    <% } %>
  </div>
</div>

<header class="site-header" id="siteHeader">
  <div class="site-header__inner">
    <button class="burger" id="navBurger" type="button" aria-label="<%= lang === 'ar' ? 'القائمة' : 'Menu' %>" aria-controls="navDrawer" aria-expanded="false">
      <span></span><span></span>
    </button>

    <nav class="site-nav" aria-label="Primary">
      <a href="/shop/men" class="<%= currentPath.startsWith('/shop/men') ? 'is-active' : '' %>"><%= t.men %></a>
      <a href="/shop/women" class="<%= currentPath.startsWith('/shop/women') ? 'is-active' : '' %>"><%= t.women %></a>
      <a href="/shop/unisex" class="<%= currentPath.startsWith('/shop/unisex') ? 'is-active' : '' %>"><%= t.unisex %></a>
      <a href="/collections" class="<%= currentPath.startsWith('/collections') ? 'is-active' : '' %>"><%= t.brands %></a>
    </nav>

    <a href="/" class="wordmark" aria-label="Jamaludeen home">
      <% if (logo) { %>
        <img src="<%= logo %>" alt="JAMALUDEEN"/>
      <% } else { %>
        <span class="wordmark__name">JAMALUDEEN</span>
        <span class="wordmark__sub">Maison de Parfum · <span lang="ar">جمال الدين</span></span>
      <% } %>
    </a>

    <div class="site-actions">
      <a href="/contact" class="site-actions__link <%= currentPath === '/contact' ? 'is-active' : '' %>"><%= t.contact %></a>
      <form action="/set-lang" method="POST" class="site-actions__lang">
        <button type="submit" name="lang" value="<%= lang === 'ar' ? 'en' : 'ar' %>" class="chip" aria-label="Change language"><%= lang === 'ar' ? 'EN' : 'عربي' %></button>
      </form>
      <button class="chip chip--currency" id="currencyToggle" type="button" data-rate="<%= usdRate %>" title="LBP / USD">
        <span id="currencyLabel">LBP</span>
      </button>
      <a href="/wishlist" class="icon-btn" aria-label="Wishlist">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span class="icon-btn__badge wishlist-count" hidden>0</span>
      </a>
      <a href="/cart" class="icon-btn" aria-label="<%= t.cart %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M5.5 8h13l-1 13h-11l-1-13Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <% if (cartCount > 0) { %><span class="icon-btn__badge"><%= cartCount %></span><% } %>
      </a>
    </div>
  </div>
</header>

<div class="drawer-scrim" id="navOverlay"></div>
<aside class="drawer" id="navDrawer" aria-hidden="true">
  <div class="drawer__head">
    <span class="drawer__brand">JAMALUDEEN</span>
    <button class="drawer__close" id="navClose" type="button" aria-label="Close">✕</button>
  </div>
  <nav class="drawer__nav">
    <a href="/"><span>00</span><%= t.home %></a>
    <a href="/shop/men"><span>01</span><%= t.men %></a>
    <a href="/shop/women"><span>02</span><%= t.women %></a>
    <a href="/shop/unisex"><span>03</span><%= t.unisex %></a>
    <a href="/collections"><span>04</span><%= t.brands %></a>
    <a href="/wishlist"><span>05</span><%= lang === 'ar' ? 'المفضلة' : 'Wishlist' %></a>
    <a href="/contact"><span>06</span><%= t.contact %></a>
  </nav>
  <div class="drawer__foot">
    <form action="/set-lang" method="POST">
      <button type="submit" name="lang" value="<%= lang === 'ar' ? 'en' : 'ar' %>" class="chip chip--light"><%= lang === 'ar' ? 'English' : 'العربية' %></button>
    </form>
    <a class="drawer__wa" href="https://wa.me/<%= waNumber %>" target="_blank" rel="noopener">WhatsApp ↗</a>
  </div>
</aside>
