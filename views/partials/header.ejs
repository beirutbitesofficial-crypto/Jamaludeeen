<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | JAMALUDEEN</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

<!-- Flash messages -->
<% if (success_msg && success_msg.length) { %>
<div class="flash flash--success"><%= success_msg[0] %> <button class="flash__close" onclick="this.parentElement.remove()">✕</button></div>
<% } %>
<% if (error_msg && error_msg.length) { %>
<div class="flash flash--error"><%= error_msg[0] %> <button class="flash__close" onclick="this.parentElement.remove()">✕</button></div>
<% } %>

<!-- Mobile nav overlay -->
<div class="nav-overlay" id="navOverlay"></div>

<!-- Navbar -->
<nav class="navbar" id="navbar">
  <div class="navbar__inner">

    <!-- Hamburger -->
    <button class="navbar__burger" id="navBurger" type="button" aria-label="menu" aria-controls="navLinks" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <!-- Logo -->
    <a href="/" class="navbar__logo">
      <% if (typeof logo !== 'undefined' && logo) { %>
        <img src="<%= logo %>" alt="JAMALUDEEN" height="40"/>
      <% } else { %>
        JAMALUDEEN
      <% } %>
    </a>

    <!-- Links -->
    <ul class="navbar__links" id="navLinks" aria-hidden="true">
      <li><a href="/" class="<%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'active' : '' %>"><%= t.home %></a></li>
      <li><a href="/shop/men"><%= t.men %></a></li>
      <li><a href="/shop/women"><%= t.women %></a></li>
      <li><a href="/shop/unisex"><%= t.unisex %></a></li>
      <li><a href="/collections"><%= lang === 'ar' ? 'الماركات' : 'Brands' %></a></li>
      <li><a href="/contact"><%= t.contact %></a></li>
    </ul>

    <!-- Right actions -->
    <div class="navbar__right">
      <!-- Language toggle -->
      <form action="/set-lang" method="POST" class="lang-form">
        <button type="submit" name="lang" value="<%= lang === 'ar' ? 'en' : 'ar' %>" class="btn-lang">
          <%= lang === 'ar' ? 'EN' : 'عربي' %>
        </button>
      </form>

      <!-- Currency toggle -->
      <button class="btn-currency" id="currencyToggle"
              data-rate="<%= settings.usd_rate || 89500 %>"
              title="Toggle LBP / USD">
        <span id="currencyLabel">LBP</span>
      </button>

      <!-- Wishlist -->
      <a href="/wishlist" class="navbar__cart" title="Wishlist">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span class="navbar__cart-badge wishlist-count" style="display:none;background:#c9a96e">0</span>
      </a>

      <!-- Cart -->
      <a href="/cart" class="navbar__cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <% if (cartCount > 0) { %><span class="navbar__cart-badge"><%= cartCount %></span><% } %>
      </a>
    </div>

  </div>
</nav>
