<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="theme-color" content="#0a0a0a"/>
  <meta name="description" content="Jamaludeen — premium perfumes for men, women and everyone in between. Shop online with delivery across Lebanon."/>
  <title><%= title %> | JAMALUDEEN</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Montserrat:wght@300;400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css?v=20260805-4" type="text/css"/>
  <link rel="stylesheet" href="/css/storefront-v2.css?v=20260917-1" type="text/css"/>
</head>
<body>

<!-- Flash messages -->
<% if (success_msg && success_msg.length) { %>
<div class="flash flash--success"><%= success_msg[0] %> <button class="flash__close" onclick="this.parentElement.remove()">✕</button></div>
<% } %>
<% if (error_msg && error_msg.length) { %>
<div class="flash flash--error"><%= error_msg[0] %> <button class="flash__close" onclick="this.parentElement.remove()">✕</button></div>
<% } %>

<!-- Store announcement -->
<div class="store-announcement">
  <div class="store-announcement__inner">
    <span><%= lang === 'ar' ? 'توصيل لكل لبنان' : 'Delivery across Lebanon' %></span>
    <span class="store-announcement__dot">•</span>
    <span><%= lang === 'ar' ? 'دفع عند الاستلام أو Whish Money' : 'Cash on delivery or Whish Money' %></span>
    <span class="store-announcement__dot store-announcement__dot--desktop">•</span>
    <span class="store-announcement__desktop"><%= lang === 'ar' ? 'اختار عطرك بثقة' : 'Find your signature scent' %></span>
  </div>
</div>

<!-- Mobile nav overlay -->
<div class="nav-overlay" id="navOverlay"></div>

<!-- Navbar -->
<nav class="navbar" id="navbar">
  <div class="navbar__inner">

    <button class="navbar__burger" id="navBurger" type="button" aria-label="menu" aria-controls="navLinks" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <a href="/" class="navbar__logo" aria-label="Jamaludeen home">
      <% if (typeof logo !== 'undefined' && logo) { %>
        <img src="<%= logo %>" alt="JAMALUDEEN"/>
      <% } else { %>
        JAMALUDEEN
      <% } %>
    </a>

    <ul class="navbar__links" id="navLinks" aria-hidden="true">
      <li><a href="/" class="<%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'active' : '' %>"><%= t.home %></a></li>
      <li><a href="/shop/men"><%= t.men %></a></li>
      <li><a href="/shop/women"><%= t.women %></a></li>
      <li><a href="/shop/unisex"><%= t.unisex %></a></li>
      <li><a href="/collections"><%= lang === 'ar' ? 'الماركات' : 'Brands' %></a></li>
      <li><a href="/contact"><%= t.contact %></a></li>
    </ul>

    <div class="navbar__right">
      <form action="/set-lang" method="POST" class="lang-form">
        <button type="submit" name="lang" value="<%= lang === 'ar' ? 'en' : 'ar' %>" class="btn-lang" aria-label="Change language">
          <%= lang === 'ar' ? 'EN' : 'عربي' %>
        </button>
      </form>

      <button class="btn-currency" id="currencyToggle"
              data-rate="<%= settings.usd_rate || 89500 %>"
              title="Toggle LBP / USD">
        <span id="currencyLabel">LBP</span>
      </button>

      <a href="/wishlist" class="navbar__cart navbar__wishlist" title="Wishlist" aria-label="Wishlist">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span class="navbar__cart-badge wishlist-count" style="display:none">0</span>
      </a>

      <a href="/cart" class="navbar__cart" aria-label="Shopping bag">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M6 7h12l1 14H5L6 7Z"/>
          <path d="M9 8V5a3 3 0 0 1 6 0v3"/>
        </svg>
        <% if (cartCount > 0) { %><span class="navbar__cart-badge"><%= cartCount %></span><% } %>
      </a>
    </div>

  </div>
</nav>
