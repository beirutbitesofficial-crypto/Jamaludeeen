<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | Admin · JAMALUDEEN</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/admin.css?v=20260803-2" type="text/css"/>
</head>
<body class="admin-body">

<aside class="admin-sidebar">
  <div class="admin-sidebar__logo">JAMALUDEEN</div>
  <nav class="admin-nav">
    <a href="/admin/catalog" class="admin-nav__link">Catalog Categories</a>
    <a href="/admin/dashboard" class="admin-nav__link">📊 Dashboard</a>
    <a href="/admin/products" class="admin-nav__link">📦 Products</a>
    <a href="/admin/brands" class="admin-nav__link">🏷️ Brands</a>
    <a href="/admin/images" class="admin-nav__link">🖼️ Images</a>
    <a href="/admin/orders" class="admin-nav__link">📋 Orders</a>
    <a href="/admin/orders?status=pending" class="admin-nav__link admin-nav__link--highlight">⏳ Pending <span id="pendingNavBadge" class="nav-badge"></span></a>
    <a href="/admin/settings" class="admin-nav__link">⚙️ Settings</a>
    <a href="/" class="admin-nav__link" target="_blank">🌐 View Store</a>
  </nav>
  <form action="/admin/logout" method="POST" style="padding:16px">
    <button type="submit" class="btn-logout">↩ Logout</button>
  </form>
</aside>

<div class="admin-main">
  <!-- Flash -->
  <% if (success_msg && success_msg.length) { %>
  <div class="alert alert--success"><%= success_msg[0] %> <button onclick="this.parentElement.remove()">✕</button></div>
  <% } %>
  <% if (error_msg && error_msg.length) { %>
  <div class="alert alert--error"><%= error_msg[0] %> <button onclick="this.parentElement.remove()">✕</button></div>
  <% } %>
