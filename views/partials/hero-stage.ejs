<%#
  Cinematic hero stage: layered 2D composition animated by /js/motion/home.js.
  Layer order (back → front): arch backdrop + smoke, back bloom, side bottles,
  sparks (back), hero bottle, sparks (front), petals, front bloom, price badge.
  Everything is visible and correctly placed without JavaScript.
%>
<% const bottle = (key, extra) => { %>
  <div class="bottle bottle--<%= key %> <%= extra || '' %>" data-bottle="<%= key %>">
    <div class="bottle__float">
      <span class="bottle__neck"></span>
      <img class="bottle__body" src="/images/hero/<%= key %>-body.webp" alt="" width="218" height="550" <%- key === 'men' ? 'fetchpriority="high"' : 'loading="eager"' %> decoding="async"/>
      <span class="bottle__cap" data-cap><img src="/images/hero/<%= key %>-cap.webp" alt="" width="162" height="100" decoding="async"/></span>
      <img class="bottle__reflect" src="/images/hero/<%= key %>-body.webp" alt="" aria-hidden="true" width="218" height="550" decoding="async"/>
    </div>
  </div>
<% } %>
<div class="stage" data-stage aria-hidden="true">
  <div class="stage__arch" data-arch>
    <img class="stage__backdrop" src="<%= heroImage %>" alt="" decoding="async" fetchpriority="low"/>
    <img class="stage__smoke" src="/images/hero/smoke.webp" alt="" decoding="async" fetchpriority="low" data-smoke/>
    <span class="stage__floor"></span>
  </div>
  <div class="stage__bloom stage__bloom--back" data-bloom="back"><img src="/images/hero/bloom-b.webp" alt="" width="490" height="430" decoding="async"/></div>
  <% bottle('women', 'bottle--side') %>
  <% bottle('unisex', 'bottle--side') %>
  <canvas class="stage__sparks stage__sparks--back" data-sparks="back"></canvas>
  <% bottle('men', 'bottle--hero') %>
  <canvas class="stage__sparks stage__sparks--front" data-sparks="front"></canvas>
  <div class="stage__petals" data-petals>
    <% [['a', 18, 22, -28, 1], ['b', 72, 14, 34, .8], ['c', 84, 46, 62, 1.1], ['a', 10, 58, -70, .7], ['b', 30, 8, 12, .55], ['c', 64, 70, -40, .9], ['a', 90, 26, 110, .6]].forEach(([v, x, y, r, s], i) => { %>
    <svg class="petal petal--<%= v %>" style="--x:<%= x %>%;--y:<%= y %>%;--r:<%= r %>deg;--s:<%= s %>" viewBox="0 0 60 90" data-petal="<%= i %>"><use href="#jm-petal-<%= v %>"/></svg>
    <% }) %>
  </div>
  <div class="stage__bloom stage__bloom--front" data-bloom="front"><img src="/images/hero/bloom-a.webp" alt="" width="518" height="512" decoding="async"/></div>
</div>

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="jm-pg-a" cx="35%" cy="30%" r="80%"><stop offset="0" stop-color="#f7c9d7"/><stop offset=".55" stop-color="#c7577f"/><stop offset="1" stop-color="#5e1736"/></radialGradient>
    <radialGradient id="jm-pg-b" cx="40%" cy="25%" r="85%"><stop offset="0" stop-color="#fbe3ea"/><stop offset=".6" stop-color="#d98aa6"/><stop offset="1" stop-color="#7a2a4b"/></radialGradient>
    <radialGradient id="jm-pg-c" cx="45%" cy="30%" r="80%"><stop offset="0" stop-color="#e9b2c5"/><stop offset=".6" stop-color="#9c3561"/><stop offset="1" stop-color="#3f0f25"/></radialGradient>
    <symbol id="jm-petal-a" viewBox="0 0 60 90"><path fill="url(#jm-pg-a)" d="M30 88C10 70 2 46 6 28 10 10 22 2 32 2c12 0 24 10 24 28 0 22-10 42-26 58z"/><path fill="none" stroke="rgba(255,255,255,.18)" stroke-width="1" d="M30 84C26 60 26 36 33 8"/></symbol>
    <symbol id="jm-petal-b" viewBox="0 0 60 90"><path fill="url(#jm-pg-b)" d="M28 88C12 72 4 52 8 32 12 14 24 4 36 6c12 2 20 16 18 32-3 22-12 36-26 50z"/><path fill="none" stroke="rgba(255,255,255,.2)" stroke-width="1" d="M28 84c0-26 4-50 10-74"/></symbol>
    <symbol id="jm-petal-c" viewBox="0 0 60 90"><path fill="url(#jm-pg-c)" d="M31 88C14 74 6 54 9 34 12 16 22 6 31 4c11-1 21 9 22 26 1 24-8 42-22 58z"/><path fill="none" stroke="rgba(255,255,255,.14)" stroke-width="1" d="M31 84c-3-24-2-48 2-76"/></symbol>
  </defs>
</svg>
