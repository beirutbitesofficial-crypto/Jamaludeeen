          </a>
          <% } %>
        </div>
      </div>

      <div class="site-footer__cols">
        <div>
          <h4><%= lang === 'ar' ? 'تسوّق' : 'The Collection' %></h4>
          <a href="/shop/men"><%= t.men_perfumes %></a>
          <a href="/shop/women"><%= t.women_perfumes %></a>
          <a href="/shop/unisex"><%= t.unisex_perfumes %></a>
          <a href="/collections"><%= t.brands %></a>
        </div>
        <div>
          <h4><%= lang === 'ar' ? 'البوتيك' : 'The Boutique' %></h4>
          <a href="/contact">JMR Mall, Mazboud</a>
          <a href="https://wa.me/<%= waNumber %>" target="_blank" rel="noopener" dir="ltr">+<%= waNumber.replace(/^961/, '961 ') %></a>
          <% if (settings.instagram) { %><a href="https://instagram.com/<%= settings.instagram.replace(/^@/, '') %>" target="_blank" rel="noopener">@<%= settings.instagram.replace(/^@/, '') %></a><% } %>
          <a href="/contact"><%= t.contact %></a>
        </div>
        <div>
          <h4><%= lang === 'ar' ? 'الدفع' : 'Payment' %></h4>
          <span><%= t.cash_on_delivery %></span>
          <span><%= t.bywhish_money %><% if (settings.whish_number) { %> · <bdi><%= settings.whish_number %></bdi><% } %></span>
          <span><%= lang === 'ar' ? 'توصيل لكل لبنان' : 'Delivery across Lebanon' %></span>
        </div>
      </div>
    </div>

    <div class="site-footer__giant" aria-hidden="true">Jamaludeen</div>

    <div class="site-footer__bottom">
      <p>&copy; <%= new Date().getFullYear() %> JAMALUDEEN — <%= lang === 'ar' ? 'جميع الحقوق محفوظة' : 'All rights reserved' %></p>
      <p><%= lang === 'ar' ? 'صُنع بعناية في لبنان' : 'Crafted with care in Lebanon' %></p>
    </div>
  </div>
</footer>

