    </div>

    <!-- Nav cols -->
    <div class="footer__cols">
      <div class="footer__col">
        <h4><%= lang === 'ar' ? 'تسوق' : 'Shop' %></h4>
        <ul>
          <li><a href="/shop/men"><%= t.men_perfumes %></a></li>
          <li><a href="/shop/women"><%= t.women_perfumes %></a></li>
          <li><a href="/shop/unisex"><%= t.unisex_perfumes %></a></li>
          <li><a href="/collections"><%= t.brands %></a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h4><%= lang === 'ar' ? 'تواصل' : 'Contact' %></h4>
        <ul>
          <% if (settings.store_whatsapp) { %>
          <li><a href="https://wa.me/961<%= settings.store_whatsapp.replace(/[^0-9]/g,'') %>" target="_blank">WhatsApp: <%= settings.store_whatsapp %></a></li>
          <% } %>
          <% if (settings.instagram) { %>
          <li><a href="https://instagram.com/<%= settings.instagram %>" target="_blank">@<%= settings.instagram %></a></li>
          <% } %>
          <li><a href="/contact"><%= t.contact %></a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h4><%= lang === 'ar' ? 'الدفع' : 'Payment' %></h4>
        <ul>
          <li><%= t.cash_on_delivery %></li>
          <li><%= t.bywhish_money %> · <%= settings.whish_number || '' %></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <p>&copy; <%= new Date().getFullYear() %> JAMALUDEEN &mdash; <%= lang === 'ar' ? 'جميع الحقوق محفوظة' : 'All rights reserved' %></p>
