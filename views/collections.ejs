<%- include('partials/header', { title: title }) %>
<% const ar = lang === 'ar'; %>

<main>
  <section class="page-hero">
    <div class="container">
      <nav class="crumbs"><a href="/"><%= t.home %></a><span>/</span><span><%= t.brands %></span></nav>
      <div class="page-hero__row">
        <div>
          <p class="eyebrow"><span></span><%= ar ? 'دليل دور العطور' : 'The House Directory' %></p>
          <h1 class="display display--xl"><%= ar ? 'الماركات' : 'The Houses' %></h1>
          <p class="page-hero__lede"><%= ar ? 'اكتشف مجموعتنا المختارة من أشهر دور العطور العالمية والخليجية.' : 'A considered edit of international and Khaleeji fragrance houses.' %></p>
        </div>
      </div>
      <nav class="tabs" aria-label="Collections">
        <a href="/shop/men"><%= t.men %></a>
        <a href="/shop/women"><%= t.women %></a>
        <a href="/shop/unisex"><%= t.unisex %></a>
        <a href="/collections" class="is-active"><%= t.brands %></a>
      </nav>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <div class="toolbar">
        <label class="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" id="brandSearch" placeholder="<%= ar ? 'ابحث عن ماركة...' : 'Find a fragrance house…' %>" autocomplete="off" aria-label="Search brands"/>
        </label>
        <p class="toolbar__count"><%= western.length + khaleeji.length %> <%= ar ? 'ماركة' : 'houses' %></p>
      </div>

      <% [[t.western_brands, western, 'I'], [t.khaleeji_brands, khaleeji, 'II']].forEach(([heading, list, num]) => { if (!list.length) return; %>
      <section class="house-group" data-brand-group>
        <h2 class="house-group__title"><span><%= num %></span><%= heading %></h2>
        <div class="house-grid">
          <% list.forEach(b => { %>
          <a href="/collections/<%= b.id %>" class="house-card" data-brand-name="<%= b.name.toLowerCase() %> <%= (b.name_ar || '').toLowerCase() %>">
            <% if (b.logo_path) { %>
              <img src="<%= b.logo_path %>" alt="<%= b.name %>" class="house-card__logo"/>
            <% } else { %>
              <span class="house-card__initial"><%= b.name.charAt(0) %></span>
            <% } %>
            <span class="house-card__name"><bdi><%= b.name %></bdi></span>
            <% if (b.name_ar) { %><span class="house-card__ar" lang="ar"><%= b.name_ar %></span><% } %>
            <span class="house-card__cta"><%= t.shop_now %></span>
          </a>
          <% }) %>
        </div>
      </section>
      <% }) %>

      <div class="empty" id="brandEmpty" <% if (western.length || khaleeji.length) { %>hidden<% } %>>
        <span class="empty__mark">✦</span>
        <h2><%= ar ? 'لا توجد ماركات' : 'No houses found' %></h2>
        <p><%= ar ? 'جرّب اسماً آخر.' : 'Try another name.' %></p>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
