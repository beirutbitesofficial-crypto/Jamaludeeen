<%- include('partials/header', { title: title }) %>

<div class="brands-page">
  <div class="container">

    <div class="page-header">
      <p class="page-header__eyebrow"><%= lang === 'ar' ? 'Ø¯Ù„ÙŠÙ„ Ø¯ÙˆØ± Ø§Ù„Ø¹Ø·ÙˆØ±' : 'THE HOUSE DIRECTORY' %></p>
      <h1 class="page-header__title"><%= lang === 'ar' ? 'Ø§Ù„Ù…Ø§Ø±ÙƒØ§Øª' : 'Brands' %></h1>
      <p class="page-header__intro"><%= lang === 'ar' ? 'Ø§ÙƒØªØ´Ù Ù…Ø¬Ù…ÙˆØ¹ØªÙ†Ø§ Ø§Ù„Ù…Ø®ØªØ§Ø±Ø© Ù…Ù† Ø£Ø´Ù‡Ø± Ø¯ÙˆØ± Ø§Ù„Ø¹Ø·ÙˆØ± Ø§Ù„Ø¹Ø§Ù„Ù…ÙŠØ© ÙˆØ§Ù„Ø®Ù„ÙŠØ¬ÙŠØ©.' : 'Explore a considered edit of international and Khaleeji fragrance houses.' %></p>
      <nav class="collection-tabs" aria-label="Catalog categories">
        <a href="/shop/men"><%= t.men %></a>
        <a href="/shop/women"><%= t.women %></a>
        <a href="/shop/unisex"><%= t.unisex %></a>
        <a href="/collections" class="active"><%= t.brands %></a>
      </nav>
    </div>

    <!-- International Brands -->
    <% if (western.length) { %>
    <section class="brands-section">
      <h2 class="brands-section__title"><%= t.western_brands %></h2>
      <div class="brands-grid">
        <% western.forEach(b => { %>
        <a href="/collections/<%= b.id %>" class="brand-card">
          <% if (b.logo_path) { %>
            <img src="<%= b.logo_path %>" alt="<%= b.name %>" class="brand-card__logo"/>
          <% } %>
          <div class="brand-card__name"><%= b.name %></div>
          <% if (b.name_ar) { %><div class="brand-card__name-ar"><%= b.name_ar %></div><% } %>
        </a>
        <% }) %>
      </div>
    </section>
    <% } %>

    <!-- Arabic & Khaleeji Brands -->
    <% if (khaleeji.length) { %>
    <section class="brands-section">
      <h2 class="brands-section__title"><%= t.khaleeji_brands %></h2>
      <div class="brands-grid">
        <% khaleeji.forEach(b => { %>
        <a href="/collections/<%= b.id %>" class="brand-card brand-card--khaleeji">
          <% if (b.logo_path) { %>
            <img src="<%= b.logo_path %>" alt="<%= b.name %>" class="brand-card__logo"/>
          <% } %>
          <div class="brand-card__name"><%= b.name %></div>
          <% if (b.name_ar) { %><div class="brand-card__name-ar"><%= b.name_ar %></div><% } %>
        </a>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (!western.length && !khaleeji.length) { %>
    <div class="empty-state">
      <p class="empty-state__icon">âœ¦</p>
      <h3><%= lang === 'ar' ? 'Ù„Ø§ ØªÙˆØ¬Ø¯ Ù…Ø§Ø±ÙƒØ§Øª Ø¨Ø¹Ø¯' : 'No brands yet' %></h3>
      <p><%= lang === 'ar' ? 'Ø³ÙŠØªÙ… Ø¥Ø¶Ø§ÙØ© Ø§Ù„Ù…Ø§Ø±ÙƒØ§Øª Ù‚Ø±ÙŠØ¨Ø§Ù‹' : 'Brands will be added soon' %></p>
    </div>
    <% } %>

  </div>
</div>

<%- include('partials/footer') %>

