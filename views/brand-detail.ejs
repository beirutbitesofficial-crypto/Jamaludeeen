<%- include('partials/header', { title: title }) %>
<% const ar = lang === 'ar'; %>

<main>
  <section class="page-hero">
    <div class="container">
      <nav class="crumbs"><a href="/"><%= t.home %></a><span>/</span><a href="/collections"><%= t.brands %></a><span>/</span><span><bdi><%= brand.name %></bdi></span></nav>
      <div class="page-hero__row">
        <div>
          <p class="eyebrow"><span></span><%= ar ? 'دار العطور' : 'The House' %></p>
          <% if (brand.logo_path) { %><img src="<%= brand.logo_path %>" alt="<%= brand.name %>" class="page-hero__logo"/><% } %>
          <h1 class="display display--xl"><bdi><%= brand.name %></bdi></h1>
          <% if (brand.name_ar) { %><p class="page-hero__lede" lang="ar"><%= brand.name_ar %></p><% } %>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <% if (categories.length) { %>
      <div class="lines">
        <% categories.forEach((cat, i) => { %>
        <a href="/collections/<%= brand.id %>/category/<%= cat.id %>" class="line reveal">
          <div class="line__media">
            <% if (cat.image_path) { %><img src="<%= thumb(cat.image_path) %>" alt="<%= cat.name_en %>" loading="lazy"/><% } else { %><span class="card__monogram"><%= brand.name.charAt(0) %></span><% } %>
          </div>
          <div class="line__body">
            <span class="line__num"><%= String(i + 1).padStart(2, '0') %></span>
            <h3><%= ar && cat.name_ar ? cat.name_ar : cat.name_en %></h3>
            <p><%= cat.product_count %> <%= t.products %></p>
            <span class="link-arrow"><%= t.shop_now %></span>
          </div>
        </a>
        <% }) %>
      </div>
      <% } else { %>
      <div class="empty">
        <span class="empty__mark">✦</span>
        <h2><%= ar ? 'لا توجد تصنيفات بعد' : 'No lines yet' %></h2>
        <p><%= ar ? 'سيتم إضافة التصنيفات قريباً' : 'This house will be stocked soon.' %></p>
        <a href="/collections" class="btn btn--dark"><%= ar ? 'كل الماركات' : 'All houses' %></a>
      </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
