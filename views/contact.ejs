<%- include('partials/header', { title: 'Contact' }) %>
<% const ar = lang === 'ar'; const waPretty = '+' + waNumber.replace(/^961(\d{2})(\d{3})(\d+)$/, '961 $1 $2 $3'); %>

<main>
  <section class="page-hero page-hero--dark">
    <div class="container">
      <p class="eyebrow eyebrow--light"><span></span><%= ar ? 'نحن هنا لخدمتكم' : 'Personal service' %></p>
      <h1 class="display display--xl display--light"><%= ar ? 'تواصل معنا' : 'Let’s find your signature scent.' %></h1>
      <p class="page-hero__lede"><%= ar ? 'زورونا في مزبود أو تواصلوا معنا مباشرة عبر واتساب. يسعدنا مساعدتكم في اختيار عطركم.' : 'Visit our boutique in Mazboud or speak with us directly on WhatsApp. We would be delighted to help you choose.' %></p>
    </div>
  </section>

  <section class="section">
    <div class="container visit">
      <div class="visit__details reveal">
        <p class="eyebrow"><span></span><%= ar ? 'بوتيك جمال الدين' : 'Jamaludeen Boutique' %></p>
        <h2 class="display"><%= ar ? 'زيارتكم تسعدنا' : 'Visit the boutique' %></h2>

        <div class="visit__row">
          <span><%= ar ? 'الموقع' : 'Location' %></span>
          <strong>JMR Mall, Mazboud, Lebanon</strong>
          <a class="link-arrow" href="https://www.google.com/maps/search/?api=1&query=JMR+Mall+Mazboud+Lebanon" target="_blank" rel="noopener"><%= ar ? 'افتح الخريطة' : 'Get directions' %></a>
        </div>
        <div class="visit__row">
          <span>WhatsApp</span>
          <strong dir="ltr"><%= waPretty %></strong>
          <a class="link-arrow" href="https://wa.me/<%= waNumber %>" target="_blank" rel="noopener"><%= ar ? 'ابدأ المحادثة' : 'Start a conversation' %></a>
        </div>
        <div class="visit__row">
          <span><%= ar ? 'خدمة التوصيل' : 'Delivery' %></span>
          <strong><%= ar ? 'توصيل إلى جميع المناطق اللبنانية' : 'Available across Lebanon' %></strong>
        </div>

        <a class="btn btn--gold" href="https://wa.me/<%= waNumber %>?text=<%= encodeURIComponent(ar ? 'مرحباً جمال الدين، بدي مساعدة باختيار عطر.' : 'Hello Jamaludeen, I would like help choosing a perfume.') %>" target="_blank" rel="noopener"><%= ar ? 'تواصل عبر واتساب' : 'Chat on WhatsApp' %></a>
      </div>

      <div class="visit__map reveal">
        <iframe title="JMR Mall, Mazboud" src="https://www.google.com/maps?q=JMR%20Mall%2C%20Mazboud%2C%20Lebanon&output=embed" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
        <div class="visit__label"><span>JAMALUDEEN</span><strong>JMR Mall · Mazboud</strong></div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
