<%- include('partials/header', { title: t.order_success }) %>
<% const ar = lang === 'ar';
   const cur = order.currency || 'LBP';
   const money = n => cur === 'USD' ? '$' + Number(n || 0).toFixed(2).replace(/\.00$/, '') : Math.round(n || 0).toLocaleString('en-US') + ' LBP';
   const waLink = order.whatsappUrl || `https://wa.me/${waNumber}?text=${encodeURIComponent('Order: ' + order.orderNumber)}`; %>

<main class="section section--page">
  <div class="container">
    <section class="receipt">
      <div class="receipt__seal">✓</div>
      <p class="eyebrow eyebrow--center"><span></span><%= t.thank_you %><span></span></p>
      <h1 class="display"><%= t.order_success %></h1>
      <p class="receipt__lede"><%= ar ? 'طلبك محفوظ. أرسل رسالة الطلب على واتساب ليتم تأكيده مباشرة.' : 'Your order is saved. Send it to us on WhatsApp and we will confirm it right away.' %></p>

      <dl class="receipt__rows">
        <div><dt><%= t.order_number %></dt><dd class="receipt__number"><%= order.orderNumber %></dd></div>
        <div><dt><%= t.total %></dt><dd><%= money(order.total) %></dd></div>
        <div><dt><%= t.payment_method %></dt><dd><%= order.paymentMethod === 'whish' ? t.bywhish_money : t.cash_on_delivery %></dd></div>
      </dl>

      <% if (order.paymentMethod === 'whish' && order.whishNumber) { %>
      <div class="receipt__whish">
        <p><%= t.whish_instructions %></p>
        <strong dir="ltr"><%= order.whishNumber %></strong>
        <p><%= t.whish_ref %> <b><%= order.orderNumber %></b></p>
      </div>
      <% } %>

      <a href="<%= waLink %>" class="btn btn--gold btn--block btn--lg" id="sendOrder" data-order="<%= order.orderNumber %>" target="_blank" rel="noopener"><%= ar ? 'أرسل الطلب على واتساب' : 'Send order on WhatsApp' %></a>
      <a href="/" class="btn btn--line btn--block"><%= t.continue_shopping %></a>
    </section>
  </div>
</main>

<%- include('partials/footer') %>
