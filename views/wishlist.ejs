<%- include('partials/header', { title: 'Wishlist' }) %>
<% const ar = lang === 'ar'; %>

<main class="section section--page">
  <div class="container">
    <header class="page-title">
      <p class="eyebrow"><span></span><%= ar ? 'محفوظاتك' : 'Saved for later' %></p>
      <h1 class="display display--xl"><%= ar ? 'المفضلة' : 'Wishlist' %></h1>
      <p id="wishlistHeader"></p>
    </header>

    <div class="empty empty--large" id="wishlistEmpty" hidden>
      <span class="empty__mark">♡</span>
      <h2><%= ar ? 'قائمة المفضلة فارغة' : 'Your wishlist is empty' %></h2>
      <p><%= ar ? 'اضغط على القلب على أي عطر لحفظه هنا' : 'Tap the heart on any fragrance to keep it here.' %></p>
      <a href="/shop/men" class="btn btn--dark"><%= ar ? 'تصفح العطور' : 'Browse fragrances' %></a>
    </div>

    <div id="wishlistGrid" class="grid-products"></div>
  </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const ar = <%- JSON.stringify(ar) %>;
  const grid = document.getElementById('wishlistGrid');
  const empty = document.getElementById('wishlistEmpty');
  const header = document.getElementById('wishlistHeader');

  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const heart = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>';

  function setCount(n) {
    header.textContent = n ? n + (ar ? ' عطر محفوظ' : (n === 1 ? ' fragrance saved' : ' fragrances saved')) : '';
    empty.hidden = n > 0;
    grid.hidden = n === 0;
    window.updateWishlistCount && window.updateWishlistCount();
  }

  function price(p) {
    if (p.type === 'local' && p.price_50ml) return '<span>' + (ar ? 'من' : 'From') + ' <bdi>$' + esc(p.price_50ml) + '</bdi></span><em dir="ltr">50 · 100 ml</em>';
    if (p.price) return '<span class="price-display" data-lbp="' + Number(p.price) + '">' + (window.currencyFmt ? window.currencyFmt(Number(p.price)) : Number(p.price).toLocaleString('en-US') + ' LBP') + '</span>';
    return '<span class="is-muted">' + (ar ? 'السعر قريباً' : 'Price coming soon') + '</span>';
  }

  function card(p) {
    const media = p.image_path
      ? '<img src="' + esc(p.image_path) + '" alt="' + esc(p.name_en) + '" loading="lazy" referrerpolicy="no-referrer" data-fallback="' + esc(p.brand || '') + '"/>'
      : '<div class="card__placeholder"><span class="card__monogram">J</span><span class="card__ph-name">' + esc(p.name_en) + '</span></div>';
    return '<article class="card is-visible" data-card="' + p.id + '">' +
      '<div class="card__media-wrap"><a href="/shop/item/' + p.id + '" class="card__media">' + media + '</a>' +
      '<button class="wish-btn card__wish is-active" type="button" data-remove="' + p.id + '" aria-label="Remove">' + heart + '</button>' +
      '<a href="/shop/item/' + p.id + '" class="card__quick"><span>' + (ar ? 'عرض المنتج' : 'View product') + '</span></a></div>' +
      '<div class="card__body"><p class="card__house">' + esc(p.brand || 'Jamaludeen') + '</p>' +
      '<a href="/shop/item/' + p.id + '" class="card__name">' + esc(p.name_en) + '</a>' +
      '<p class="card__price">' + price(p) + '</p></div></article>';
  }

  grid.addEventListener('click', e => {
    const btn = e.target.closest('[data-remove]');
    if (!btn) return;
    e.preventDefault();
    const id = btn.dataset.remove;
    window.toggleWishlist(id);
    grid.querySelector('[data-card="' + id + '"]')?.remove();
    setCount(grid.children.length);
  });

  const ids = window.getWishlist ? window.getWishlist() : [];
  if (!ids.length) return setCount(0);

  fetch('/api/products?ids=' + encodeURIComponent(ids.join(',')))
    .then(r => r.json())
    .then(products => {
      // Drop ids of products that no longer exist so the badge stays accurate.
      const found = products.map(p => String(p.id));
      if (window.saveWishlist) window.saveWishlist(ids.filter(id => found.includes(id)));
      grid.innerHTML = products.map(card).join('');
      setCount(products.length);
    })
    .catch(() => setCount(0));
});
</script>

<%- include('partials/footer') %>
