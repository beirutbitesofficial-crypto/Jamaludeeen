# Production
NODE_ENV=production
PORT=3000

# Required: use a long random value (32+ characters).
SESSION_SECRET=replace-with-a-long-random-secret

# Required on a fresh production database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# REQUIRED in production: point these to persistent Hostinger paths.
DATA_DIR=/absolute/persistent/path/jamaludeen-data
BACKUP_DIR=/absolute/persistent/path/jamaludeen-backups
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=14

STORE_PHONE=
STORE_WHATSAPP=
STORE_ADDRESS=Lebanon
WHISH_NUMBER=
